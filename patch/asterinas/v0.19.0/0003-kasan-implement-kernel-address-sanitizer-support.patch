+    {
+        init_kasan_shadow(&kpt, &preempt_guard);
+    }
+
     KERNEL_PAGE_TABLE.call_once(|| kpt);
 }
 
+#[cfg(feature = "kasan")]
+fn init_kasan_shadow(
+    kpt: &PageTable<KernelPtConfig>,
+    preempt_guard: &crate::task::DisabledPreemptGuard,
+) {
+    use align_ext::AlignExt;
+    use crate::mm::FrameAllocOptions;
+
+    crate::info!("Initializing KASAN shadow memory mappings");
+
+    let max_paddr = crate::mm::frame::max_paddr();
+    let shadow_ram_start = crate::kasan::KASAN_SHADOW_START;
+    let shadow_ram_len = (max_paddr >> crate::kasan::SHADOW_SCALE).align_up(PAGE_SIZE);
+    let shadow_ram_end = shadow_ram_start + shadow_ram_len;
+
+    let prop = PageProperty {
+        flags: PageFlags::RW,
+        cache: CachePolicy::Writeback,
+        priv_flags: PrivilegedPageFlags::GLOBAL,
+    };
+
+    const CHUNK_SIZE: usize = 2 * 1024 * 1024;
+    let mut cur_va = shadow_ram_start;
+    while cur_va < shadow_ram_end {
+        let remaining = shadow_ram_end - cur_va;
+        let chunk_len = core::cmp::min(CHUNK_SIZE, remaining);
+
+        let nframes = chunk_len / PAGE_SIZE;
+        let seg = FrameAllocOptions::new()
+            .zeroed(true)
+            .alloc_segment(nframes);
+
+        if let Ok(segment) = seg {
+            let pa_range = segment.into_raw();
+            let from = cur_va..cur_va + chunk_len;
+            let min_level = max_page_level::<KernelPtConfig>(chunk_len);
+            let mut cursor = kpt
+                .cursor_mut_with_min_level(preempt_guard, &from, min_level)
+                .unwrap();
+            for (pa, level) in largest_pages::<KernelPtConfig>(from.start, pa_range.start, chunk_len) {
+                // SAFETY: We are mapping the KASAN shadow memory for the kernel.
+                unsafe { cursor.map(MappedItem::Untracked(pa, level, prop)) };
+            }
+        }
+        cur_va += chunk_len;
+    }
+
+    crate::info!(
+        "KASAN shadow mapping complete: [{:#x}, {:#x})",
+        shadow_ram_start,
+        shadow_ram_end
+    );
+}
