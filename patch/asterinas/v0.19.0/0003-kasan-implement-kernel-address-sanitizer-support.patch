diff --git a/ostd/src/kasan.rs b/ostd/src/kasan.rs
new file mode 100644
index 000000000..36caa6898
--- /dev/null
+++ b/ostd/src/kasan.rs
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! KernelAddressSanitizer (KASAN) runtime for Asterinas.
+//!
+//! Generic KASAN implementation targeting x86_64.
+//! Shadow mapping formula:
+//!     shadow_addr = (addr >> 3) + SHADOW_OFFSET
+//!
+//! Kernel address space [0xffff_8000_0000_0000, 0xffff_ffff_ffff_ffff] (128 TiB)
+//! is shadowed into [0xffff_ec00_0000_0000, 0xffff_fc00_0000_0000) (16 TiB).
+
+#![allow(missing_docs)]
+
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// 1 shadow byte covers 8 application bytes (scale = 3).
+pub const SHADOW_SCALE: usize = 3;
+
+/// KASAN shadow offset for x86_64 48-bit address space.
+pub const SHADOW_OFFSET: usize = 0xdffffc0000000000;
+
+/// Base of the 16 TiB KASAN shadow space for the kernel higher-half.
+pub const KASAN_SHADOW_START: usize = 0xffff_ec00_0000_0000;
+
+/// Cap of the 16 TiB KASAN shadow space.
+pub const KASAN_SHADOW_END: usize = 0xffff_fc00_0000_0000;
+
+// Poison byte values:
+/// Granule is completely accessible.
+pub const KASAN_UNPOISONED: i8 = 0x00;
+/// Free page.
+pub const KASAN_PAGE_FREE: i8 = -2; // 0xfe
+/// Heap slot freed (quarantine / use-after-free).
+pub const KASAN_SLAB_FREE: i8 = -3; // 0xfd
+/// Heap slot redzone (slab-out-of-bounds).
+pub const KASAN_SLAB_REDZONE: i8 = -6; // 0xfa
+/// Global variable redzone.
+pub const KASAN_GLOBAL_REDZONE: i8 = -7; // 0xf9
+/// Stack variable left redzone.
+pub const KASAN_STACK_LEFT: i8 = -15; // 0xf1
+/// Stack variable middle redzone.
+pub const KASAN_STACK_MID: i8 = -14; // 0xf2
+/// Stack variable right redzone.
+pub const KASAN_STACK_RIGHT: i8 = -13; // 0xf3
+
+/// Reentrancy guard to prevent recursive error reporting.
+static IN_KASAN_REPORT: AtomicBool = AtomicBool::new(false);
+
+/// Converts a kernel virtual address to its corresponding shadow memory pointer.
+#[inline(never)]
+#[sanitize(address = "off")]
+pub fn addr_to_shadow(addr: usize) -> *mut i8 {
+    let shadow_addr = (addr >> SHADOW_SCALE).wrapping_add(SHADOW_OFFSET);
+    shadow_addr as *mut i8
+}
+
+/// Checks whether an address range is accessible according to shadow memory.
+#[inline(never)]
+#[sanitize(address = "off")]
+pub fn check_memory_region(addr: usize, size: usize, is_write: bool) {
+    if size == 0 {
+        return;
+    }
+
+    // Filter out invalid/user addresses in kernel context
+    if addr < 0xffff_8000_0000_0000 {
+        report_error(addr, size, is_write, "user-or-null-ptr-deref", 0);
+        return;
+    }
+
+    // Prevent recursion during report
+    if IN_KASAN_REPORT.load(Ordering::Relaxed) {
+        return;
+    }
+
+    let first_granule = addr >> SHADOW_SCALE;
+    let last_granule = (addr + size - 1) >> SHADOW_SCALE;
+
+    for g in first_granule..=last_granule {
+        let shadow_ptr = (g.wrapping_add(SHADOW_OFFSET)) as *const i8;
+        let shadow_val = unsafe { *shadow_ptr };
+
+        if shadow_val != 0 {
+            if shadow_val < 0 {
+                report_error(addr, size, is_write, error_type_name(shadow_val), shadow_val);
+                return;
+            }
+            if g < last_granule {
+                report_error(addr, size, is_write, error_type_name(shadow_val), shadow_val);
+                return;
+            }
+            let last_byte = ((addr + size - 1) & 7) as i8;
+            if last_byte >= shadow_val {
+                report_error(addr, size, is_write, error_type_name(shadow_val), shadow_val);
+                return;
+            }
+        }
+    }
+}
+
+/// Sets shadow bytes for a memory range to a poison value.
+#[sanitize(address = "off")]
+pub fn poison_range(addr: usize, size: usize, val: i8) {
+    if size == 0 || addr < 0xffff_8000_0000_0000 {
+        return;
+    }
+    let first_granule = addr >> SHADOW_SCALE;
+    let last_granule = (addr + size - 1) >> SHADOW_SCALE;
+
+    for g in first_granule..=last_granule {
+        let shadow_ptr = (g.wrapping_add(SHADOW_OFFSET)) as *mut i8;
+        unsafe { *shadow_ptr = val };
+    }
+}
+
+/// Marks a memory range as unpoisoned (valid for access).
+#[sanitize(address = "off")]
+pub fn unpoison_range(addr: usize, size: usize) {
+    if size == 0 || addr < 0xffff_8000_0000_0000 {
+        return;
+    }
+    let mut p = addr;
+    let mut s = size;
+    while s >= 8 {
+        let g = p >> SHADOW_SCALE;
+        let shadow_ptr = (g.wrapping_add(SHADOW_OFFSET)) as *mut i8;
+        unsafe { *shadow_ptr = KASAN_UNPOISONED };
+        p += 8;
+        s -= 8;
+    }
+    if s > 0 {
+        let g = p >> SHADOW_SCALE;
+        let shadow_ptr = (g.wrapping_add(SHADOW_OFFSET)) as *mut i8;
+        unsafe { *shadow_ptr = s as i8 };
+    }
+}
+
+/// Allocator hook: unpoisons user object range and poisons redzone.
+#[sanitize(address = "off")]
+pub fn alloc_hook(ptr: usize, req_size: usize, slot_size: usize) {
+    if ptr < 0xffff_8000_0000_0000 {
+        return;
+    }
+    unpoison_range(ptr, req_size);
+    let redzone_start = ptr + ((req_size + 7) & !7);
+    if redzone_start < ptr + slot_size {
+        poison_range(
+            redzone_start,
+            (ptr + slot_size) - redzone_start,
+            KASAN_SLAB_REDZONE,
+        );
+    }
+}
+
+/// Allocator hook: poisons freed slot memory as use-after-free.
+#[sanitize(address = "off")]
+pub fn free_hook(ptr: usize, slot_size: usize) {
+    if ptr < 0xffff_8000_0000_0000 {
+        return;
+    }
+    poison_range(ptr, slot_size, KASAN_SLAB_FREE);
+}
+
+/// Formats and reports a KASAN bug, printing diagnostics and halting.
+#[cold]
+#[inline(never)]
+#[sanitize(address = "off")]
+pub fn report_error(addr: usize, size: usize, is_write: bool, error_type: &str, shadow_val: i8) {
+    if IN_KASAN_REPORT.swap(true, Ordering::SeqCst) {
+        crate::power::poweroff(crate::power::ExitCode::Failure);
+    }
+
+    let access_str = if is_write { "Write" } else { "Read" };
+
+    crate::early_println!("==================================================================");
+    crate::early_println!("BUG: KASAN: {} on address {:#x}", error_type, addr);
+    crate::early_println!("{} of size {} at addr {:#x}", access_str, size, addr);
+    crate::early_println!("Shadow byte value: {:#04x}", (shadow_val as u8));
+    crate::early_println!("==================================================================");
+
+    crate::panic::print_stack_trace();
+    crate::panic::abort();
+}
+
+#[sanitize(address = "off")]
+fn error_type_name(shadow_val: i8) -> &'static str {
+    match shadow_val {
+        KASAN_SLAB_FREE => "heap-use-after-free",
+        KASAN_PAGE_FREE => "page-use-after-free",
+        KASAN_SLAB_REDZONE => "slab-out-of-bounds",
+        KASAN_STACK_LEFT | KASAN_STACK_MID | KASAN_STACK_RIGHT => "stack-out-of-bounds",
+        KASAN_GLOBAL_REDZONE => "global-out-of-bounds",
+        1..=7 => "slab-out-of-bounds",
+        _ => "out-of-bounds",
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Compiler ABI Functions
+// ---------------------------------------------------------------------------
+
+macro_rules! define_asan_load_store {
+    ($n:expr, $load_fn:ident, $store_fn:ident, $report_load_fn:ident, $report_store_fn:ident) => {
+        #[unsafe(no_mangle)]
+        #[sanitize(address = "off")]
+        pub extern "C" fn $load_fn(addr: usize) {
+            check_memory_region(addr, $n, false);
+        }
+
+        #[unsafe(no_mangle)]
+        #[sanitize(address = "off")]
+        pub extern "C" fn $store_fn(addr: usize) {
+            check_memory_region(addr, $n, true);
+        }
+
+        #[unsafe(no_mangle)]
+        #[sanitize(address = "off")]
+        pub extern "C" fn $report_load_fn(addr: usize) {
+            let sh = unsafe { *addr_to_shadow(addr) };
+            report_error(addr, $n, false, error_type_name(sh), sh);
+        }
+
+        #[unsafe(no_mangle)]
+        #[sanitize(address = "off")]
+        pub extern "C" fn $report_store_fn(addr: usize) {
+            let sh = unsafe { *addr_to_shadow(addr) };
+            report_error(addr, $n, true, error_type_name(sh), sh);
+        }
+    };
+}
+
+define_asan_load_store!(1, __asan_load1, __asan_store1, __asan_report_load1, __asan_report_store1);
+define_asan_load_store!(2, __asan_load2, __asan_store2, __asan_report_load2, __asan_report_store2);
+define_asan_load_store!(4, __asan_load4, __asan_store4, __asan_report_load4, __asan_report_store4);
+define_asan_load_store!(8, __asan_load8, __asan_store8, __asan_report_load8, __asan_report_store8);
+define_asan_load_store!(16, __asan_load16, __asan_store16, __asan_report_load16, __asan_report_store16);
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_loadN(addr: usize, size: usize) {
+    check_memory_region(addr, size, false);
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_storeN(addr: usize, size: usize) {
+    check_memory_region(addr, size, true);
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_report_load_n(addr: usize, size: usize) {
+    let sh = unsafe { *addr_to_shadow(addr) };
+    report_error(addr, size, false, error_type_name(sh), sh);
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_report_store_n(addr: usize, size: usize) {
+    let sh = unsafe { *addr_to_shadow(addr) };
+    report_error(addr, size, true, error_type_name(sh), sh);
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_memcpy(dst: *mut u8, src: *const u8, n: usize) -> *mut u8 {
+    check_memory_region(src as usize, n, false);
+    check_memory_region(dst as usize, n, true);
+    unsafe { core::ptr::copy_nonoverlapping(src, dst, n) };
+    dst
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8 {
+    check_memory_region(src as usize, n, false);
+    check_memory_region(dst as usize, n, true);
+    unsafe { core::ptr::copy(src, dst, n) };
+    dst
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_memset(dst: *mut u8, val: i32, n: usize) -> *mut u8 {
+    check_memory_region(dst as usize, n, true);
+    unsafe { core::ptr::write_bytes(dst, val as u8, n) };
+    dst
+}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_handle_no_return() {}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_register_globals(_globals: usize, _n: usize) {}
+
+#[unsafe(no_mangle)]
+#[sanitize(address = "off")]
+pub extern "C" fn __asan_unregister_globals(_globals: usize, _n: usize) {}
