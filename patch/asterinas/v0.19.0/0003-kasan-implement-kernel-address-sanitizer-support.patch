@@ -262,6 +262,48 @@ write_l2pt_entry_\bits:
     add edi, 8
     loop write_l2pt_entry_\bits
 
+    // Setup KASAN early shadow L1PT: map all 512 entries to boot_kasan_zero_page
+    lea edi, [boot_kasan_l1pt]
+    lea eax, [boot_kasan_zero_page + (PTE_PRESENT | PTE_WRITE | PTE_GLOBAL)]
+    mov ecx, 512
+write_kasan_l1pt_\bits:
+    mov dword ptr [edi], eax
+    mov dword ptr [edi + 4], 0
+    add edi, 8
+    loop write_kasan_l1pt_\bits
+
+    // Setup KASAN early shadow L2PT: map all 512 entries to boot_kasan_l1pt
+    lea edi, [boot_kasan_l2pt]
+    lea eax, [boot_kasan_l1pt + (PTE_PRESENT | PTE_WRITE | PTE_GLOBAL)]
+    mov ecx, 512
+write_kasan_l2pt_\bits:
+    mov dword ptr [edi], eax
+    mov dword ptr [edi + 4], 0
+    add edi, 8
+    loop write_kasan_l2pt_\bits
+
+    // Setup KASAN early shadow L3PT:
+    // Entry 0 covers shadow of linear map [0xffff8000_00000000, 0xffff8000_ffffffff]
+    lea edi, [boot_kasan_l3pt]
+    lea eax, [boot_kasan_l2pt + (PTE_PRESENT | PTE_WRITE | PTE_GLOBAL)]
+    mov dword ptr [edi], eax
+    mov dword ptr [edi + 4], 0
+
+    // Entry 511 covers shadow of kernel image [0xffffffff_80000000, 0xffffffff_ffffffff]
+    lea edi, [boot_kasan_l3pt + 511 * 8]
+    mov dword ptr [edi], eax
+    mov dword ptr [edi + 4], 0
+
+    // L4PT: Map KASAN shadow PML4 entries 472..503 (0xffff_ec00_0000_0000 .. 0xffff_fc00_0000_0000)
+    lea edi, [boot_l4pt + 472 * 8]
