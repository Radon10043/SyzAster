diff --git a/distro/etc_nixos/modules/core.nix b/distro/etc_nixos/modules/core.nix
index 8d6b239c4..3bc69f7bd 100644
--- a/distro/etc_nixos/modules/core.nix
+++ b/distro/etc_nixos/modules/core.nix
@@ -18,12 +18,16 @@ let
     NEW_INIT=""
     BREAK=""
     ARGS=""
+    CONSOLE="hvc0"
 
     for arg in "$@"; do
       case "$arg" in
         root=*)
           NEW_ROOT=''${arg#root=}
           ;;
+        console=*)
+          CONSOLE=''${arg#console=}
+          ;;
         init=*)
           NEW_INIT=''${arg#init=}
           ;;
@@ -56,8 +60,21 @@ let
     mount -t ext2 "$NEW_ROOT" /sysroot
     mount -t proc none /sysroot/proc
     mount --move /dev /sysroot/dev
+    if [ ! -c /sysroot/dev/console ]; then
+      case "$CONSOLE" in
+        ttyS0)
+          mknod /sysroot/dev/console c 4 64 2>/dev/null || true
+          ;;
+        tty0)
+          mknod /sysroot/dev/console c 4 0 2>/dev/null || true
+          ;;
+        hvc0|*)
+          mknod /sysroot/dev/console c 229 0 2>/dev/null || true
+          ;;
+      esac
+    fi
 
-    exec switch_root /sysroot "$NEW_INIT" "$ARGS"
+    exec switch_root /sysroot "$NEW_INIT" $ARGS
   '';
 
   initramfs = pkgs.makeInitrd {
diff --git a/distro/etc_nixos/overlays/systemd/default.nix b/distro/etc_nixos/overlays/systemd/default.nix
index 283e552f1..c1dc3f926 100644
--- a/distro/etc_nixos/overlays/systemd/default.nix
+++ b/distro/etc_nixos/overlays/systemd/default.nix
@@ -87,4 +87,10 @@ final: prev: {
 
     '';
   });
+
+  # When aster_nixos.disable-systemd is enabled, the NixOS system builder still
+  # evaluates pkgs.systemd for user units, path units, and basic tools. Pointing
+  # systemd directly at aster_systemd avoids building unpatched upstream systemd.
+  systemd = final.aster_systemd;
+  systemdMinimal = final.aster_systemd;
 }
diff --git a/kernel/core/src/syscall/ptrace.rs b/kernel/core/src/syscall/ptrace.rs
index 65562b43b..d9ae50f4b 100644
--- a/kernel/core/src/syscall/ptrace.rs
+++ b/kernel/core/src/syscall/ptrace.rs
@@ -35,8 +35,11 @@ pub(super) fn sys_ptrace(
     match request {
         PtraceRequest::PTRACE_TRACEME => {
             let current_thread = current_thread!();
-            let parent_guard = ctx.process.parent().lock();
-            let parent_main_thread = parent_guard.process().upgrade().unwrap().main_thread();
+            // Yama's ancestor check may lock this process's parent again.
+            let parent_main_thread = {
+                let parent_guard = ctx.process.parent().lock();
+                parent_guard.process().upgrade().unwrap().main_thread()
+            };
 
             do_ptrace_attach(&parent_main_thread, current_thread)?;
         }
diff --git a/kernel/core/src/syscall/set_tid_address.rs b/kernel/core/src/syscall/set_tid_address.rs
index 92274e5b0..8c16c9965 100644
--- a/kernel/core/src/syscall/set_tid_address.rs
+++ b/kernel/core/src/syscall/set_tid_address.rs
@@ -6,14 +6,7 @@ use crate::prelude::*;
 pub(super) fn sys_set_tid_address(tidptr: Vaddr, ctx: &Context) -> Result<SyscallReturn> {
     debug!("tidptr = 0x{:x}", tidptr);
 
-    let clear_child_tid = ctx.thread_local.clear_child_tid().get();
-    if clear_child_tid != 0 {
-        // According to manuals at https://man7.org/linux/man-pages/man2/set_tid_address.2.html
-        // We need to write 0 to clear_child_tid and do futex wake
-        todo!()
-    }
-
-    ctx.thread_local.set_child_tid().set(clear_child_tid);
+    ctx.thread_local.clear_child_tid().set(tidptr);
 
     let tid = ctx.posix_thread.tid();
     Ok(SyscallReturn::Return(tid as _))
diff --git a/test/initramfs/src/regression/process/ptrace/traceme_no_cap.c b/test/initramfs/src/regression/process/ptrace/traceme_no_cap.c
new file mode 100644
index 000000000..f45307c7c
--- /dev/null
+++ b/test/initramfs/src/regression/process/ptrace/traceme_no_cap.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#define _GNU_SOURCE
+
+#include <linux/capability.h>
+#include <signal.h>
+#include <sys/ptrace.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "../../common/test.h"
+
+FN_SETUP(drop_cap_sys_ptrace)
+{
+	struct __user_cap_header_struct header = {
+		.version = _LINUX_CAPABILITY_VERSION_3,
+	};
+	struct __user_cap_data_struct data[2];
+	CHECK(syscall(SYS_capget, &header, data));
+
+	const unsigned int bit = 1U << CAP_SYS_PTRACE;
+	data[0].effective &= ~bit;
+	data[0].permitted &= ~bit;
+	data[0].inheritable &= ~bit;
+	CHECK(syscall(SYS_capset, &header, data));
+}
+END_SETUP()
+
+FN_TEST(traceme_without_cap_sys_ptrace)
+{
+	pid_t child = fork();
+	if (child == 0)
+		_exit(ptrace(PTRACE_TRACEME, 0, NULL, NULL) == 0 ? 0 : 1);
+	TEST_RES(child, _ret > 0);
+	if (child < 0)
+		return;
+
+	int status = 0;
+	pid_t got = 0;
+	for (int i = 0; i < 100; i++) {
+		got = waitpid(child, &status, WNOHANG);
+		if (got != 0)
+			break;
+		usleep(10000);
+	}
+	if (got == 0)
+		kill(child, SIGKILL);
+	TEST_RES(got, _ret == child);
+	if (got == child)
+		TEST_RES(status, WIFEXITED(_ret) && WEXITSTATUS(_ret) == 0);
+}
+END_TEST()
diff --git a/test/initramfs/src/regression/process/run_test.sh b/test/initramfs/src/regression/process/run_test.sh
