From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SyzAster Authors <syzaster@asterinas.org>
Date: Sun, 1 Nov 2026 21:31:37 +0800
Subject: [PATCH 1/2] distro, kernel: fix NixOS image installation, ptrace
 lock, and set_tid_address

Ensure loop partition device nodes exist during NixOS installation,
allow ttyS0 serial console, fix PTRACE_TRACEME parent lock ordering
deadlock under Yama, and fix sys_set_tid_address panic when replacing
clear_child_tid.
---
 distro/aster_nixos_installer/default.nix      |  1 +
 .../templates/aster-nixos-install             | 41 +++++++++++++-
 .../templates/aster_configuration.nix         |  1 +
 distro/etc_nixos/modules/core.nix             | 19 ++++++-
 distro/etc_nixos/overlays/systemd/default.nix |  6 +++
 kernel/core/src/syscall/ptrace.rs             |  7 ++-
 kernel/core/src/syscall/set_tid_address.rs    |  9 +---
 .../process/ptrace/traceme_no_cap.c           | 53 +++++++++++++++++++
 .../src/regression/process/run_test.sh        |  3 ++
 .../src/regression/process/set_tid_address.c  | 22 ++++++++
 10 files changed, 149 insertions(+), 13 deletions(-)
 create mode 100644 test/initramfs/src/regression/process/ptrace/traceme_no_cap.c
 create mode 100644 test/initramfs/src/regression/process/set_tid_address.c

diff --git a/distro/aster_nixos_installer/default.nix b/distro/aster_nixos_installer/default.nix
index d4fa82bfb..37a78a006 100644
--- a/distro/aster_nixos_installer/default.nix
+++ b/distro/aster_nixos_installer/default.nix
@@ -38,6 +38,7 @@ let
       aster-target-platform = target_platform;
       aster-substituters = extra-substituters;
       aster-trusted-public-keys = extra-trusted-public-keys;
+      nixos-install = "${pkgs.nixos-install}/bin/nixos-install";
     };
     isExecutable = true;
   };
diff --git a/distro/aster_nixos_installer/templates/aster-nixos-install b/distro/aster_nixos_installer/templates/aster-nixos-install
index c028102f3..bad6c4f08 100644
--- a/distro/aster_nixos_installer/templates/aster-nixos-install
+++ b/distro/aster_nixos_installer/templates/aster-nixos-install
@@ -101,11 +101,48 @@ else
     BOOT_DEVICE="${DISK}1"
     ROOT_DEVICE="${DISK}2"
 fi
-if [ ! -b "${BOOT_DEVICE}" ] && [ ! -b "${ROOT_DEVICE}" ]; then
+create_block_device_node() {
+    device_path="$1"
+    device_name="${device_path#/dev/}"
+    sysfs_dev="/sys/class/block/${device_name}/dev"
+    if [ ! -b "${device_path}" ] && [ -r "${sysfs_dev}" ]; then
+        IFS=: read -r major minor < "${sysfs_dev}"
+        mknod "${device_path}" b "${major}" "${minor}"
+    fi
+}
+
+remove_stale_block_device_node() {
+    device_path="$1"
+    device_name="${device_path#/dev/}"
+    if [ -b "${device_path}" ] && [ ! -e "/sys/class/block/${device_name}" ]; then
+        rm -f "${device_path}"
+    fi
+}
+
+remove_stale_block_device_node "${BOOT_DEVICE}"
+remove_stale_block_device_node "${ROOT_DEVICE}"
+
+if [ ! -b "${BOOT_DEVICE}" ] || [ ! -b "${ROOT_DEVICE}" ]; then
     parted ${DISK} -- mklabel gpt
     parted ${DISK} -- mkpart ESP fat32 1MB 512MB
     parted ${DISK} -- mkpart root ext2 512MB 100%
     parted ${DISK} -- set 1 esp on
+    for _ in $(seq 1 10); do
+        blockdev --rereadpt ${DISK} || true
+        partprobe ${DISK} || true
+        partx -a ${DISK} || partx -u ${DISK} || true
+        udevadm settle || true
+        create_block_device_node "${BOOT_DEVICE}"
+        create_block_device_node "${ROOT_DEVICE}"
+        if [ -b "${BOOT_DEVICE}" ] && [ -b "${ROOT_DEVICE}" ]; then
+            break
+        fi
+        sleep 0.2
+    done
+    if [ ! -b "${BOOT_DEVICE}" ] || [ ! -b "${ROOT_DEVICE}" ]; then
+        echo "Error: failed to create partition devices ${BOOT_DEVICE} and ${ROOT_DEVICE}" >&2
+        exit 1
+    fi
     echo "partition finished"
 
     mkfs.fat -F 32 -n boot "${BOOT_DEVICE}"
@@ -171,7 +208,7 @@ SYSTEM_CLOSURE=$(nix-build "${NIXPKGS_PATH}/nixos" -A system \
     --no-out-link)
 
 export PATH=${PATH}:/run/current-system/sw/bin
-nixos-install --root ${BUILD_DIR} --no-root-passwd \
+@nixos-install@ --root ${BUILD_DIR} --no-root-passwd \
     --system "${SYSTEM_CLOSURE}" \
     "${COMMON_NIX_ARGS[@]}"
 
