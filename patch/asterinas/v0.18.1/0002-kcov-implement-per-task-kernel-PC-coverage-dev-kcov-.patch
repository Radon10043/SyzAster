diff --git a/tools/kcov-rustc.sh b/tools/kcov-rustc.sh
new file mode 100755
index 000000000..2d345bb40
--- /dev/null
+++ b/tools/kcov-rustc.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MPL-2.0
+
+# Instrument only the safe syscall implementation crate. OSTD, the allocator,
+# and the compiler's host tools must never acquire sanitizer callbacks.
+set -euo pipefail
+rustc=$1
+shift
+args=("$@")
+crate_name=
+target=
+while (($#)); do
+    case "$1" in
+        --crate-name) crate_name=$2; shift 2 ;;
+        --target) target=$2; shift 2 ;;
+        *) shift ;;
+    esac
+done
+if [[ "$crate_name" == aster_core && "$target" == x86_64-unknown-none ]]; then
+    exec "$rustc" "${args[@]}" \
+        -C passes=sancov-module \
+        -C llvm-args=-sanitizer-coverage-level=3 \
+        -C llvm-args=-sanitizer-coverage-trace-pc
+fi
+exec "$rustc" "${args[@]}"
diff --git a/tools/kcov-smoke.c b/tools/kcov-smoke.c
new file mode 100644
index 000000000..185fada85
--- /dev/null
+++ b/tools/kcov-smoke.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: MPL-2.0
+
+// Build statically on the host, then execute as root in the instrumented guest:
+// gcc -O2 -Wall -Wextra -Werror -static -pthread tools/kcov-smoke.c -o kcov-smoke
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define KCOV_INIT_TRACE _IOR('c', 1, unsigned long)
+#define KCOV_ENABLE _IO('c', 100)
+#define KCOV_DISABLE _IO('c', 101)
+#define ENTRIES (64UL << 10)
+#define REQUIRE(condition) \
+	do { \
+		if (!(condition)) { \
+			fprintf(stderr, "FAIL line %d: %s (errno=%d)\n", __LINE__, #condition, errno); \
+			exit(1); \
+		} \
+	} while (0)
+
+static void expect_error(int result, int error)
+{
+	REQUIRE(result == -1 && errno == error);
+}
+
+static void *other_thread(void *arg)
+{
+	int fd = *(int *)arg;
+	expect_error(ioctl(fd, KCOV_ENABLE, 0), EBUSY);
+	expect_error(ioctl(fd, KCOV_DISABLE, 0), EINVAL);
+	return NULL;
+}
+
+static unsigned long collect(volatile unsigned long *area, long nr)
+{
+	__atomic_store_n(&area[0], 0, __ATOMIC_RELAXED);
+	(void)syscall(nr);
+	unsigned long count = __atomic_load_n(&area[0], __ATOMIC_ACQUIRE);
+	REQUIRE(count > 0 && count < ENTRIES);
+	return count;
+}
+
+int main(void)
+{
+	int fd = open("/dev/kcov", O_RDWR | O_CLOEXEC);
+	if (fd < 0 && errno == ENOENT) {
+		fprintf(stderr, "SKIP: /dev/kcov is absent; build the guest with KCOV=1\n");
+		return 77;
+	}
+	REQUIRE(fd >= 0);
+	expect_error(ioctl(fd, KCOV_ENABLE, 0), EINVAL);
+	expect_error(ioctl(fd, KCOV_INIT_TRACE, 1), EINVAL);
+	expect_error(ioctl(fd, KCOV_INIT_TRACE, ULONG_MAX), EINVAL);
+	REQUIRE(ioctl(fd, KCOV_INIT_TRACE, ENTRIES) == 0);
+	expect_error(ioctl(fd, KCOV_INIT_TRACE, ENTRIES), EBUSY);
+	expect_error(ioctl(fd, KCOV_ENABLE, 1), EINVAL); // Comparison mode is not implemented.
+	REQUIRE(mmap(NULL, ENTRIES * sizeof(long), PROT_READ | PROT_WRITE,
+		     MAP_PRIVATE, fd, 0) == MAP_FAILED);
+	REQUIRE(mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0) == MAP_FAILED);
+	REQUIRE(mmap(NULL, ENTRIES * sizeof(long), PROT_READ | PROT_WRITE,
+		     MAP_SHARED, fd, 4096) == MAP_FAILED);
+	volatile unsigned long *area = mmap(NULL, ENTRIES * sizeof(long),
+		PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	REQUIRE(area != MAP_FAILED);
+
+	unsigned long text_start = 0, text_end = 0;
+	FILE *symbols = fopen("/proc/kallsyms", "r");
+	REQUIRE(symbols != NULL);
+	char name[64], type;
+	unsigned long address;
+	while (fscanf(symbols, "%lx %c %63s", &address, &type, name) == 3) {
+		if (!__builtin_strcmp(name, "_stext"))
+			text_start = address;
+		if (!__builtin_strcmp(name, "_etext"))
+			text_end = address;
+	}
+	fclose(symbols);
+	REQUIRE(text_start != 0 && text_end > text_start);
+	REQUIRE(ioctl(fd, KCOV_ENABLE, 0) == 0);
+	expect_error(ioctl(fd, KCOV_ENABLE, 0), EBUSY);
+	unsigned long count = collect(area, SYS_getpid);
+	unsigned long first_pc = area[1];
+	for (unsigned long i = 1; i <= count; i++)
+		REQUIRE(area[i] >= text_start && area[i] < text_end);
+	unsigned long second_count = collect(area, SYS_getppid);
+
+	// A malicious shared count must never become an unchecked kernel index.
+	__atomic_store_n(&area[0], ULONG_MAX, __ATOMIC_RELAXED);
+	(void)syscall(SYS_getpid);
+	REQUIRE(__atomic_load_n(&area[0], __ATOMIC_RELAXED) == ULONG_MAX);
+	__atomic_store_n(&area[0], 0, __ATOMIC_RELAXED);
+
+	pthread_t thread;
+	REQUIRE(pthread_create(&thread, NULL, other_thread, &fd) == 0);
+	REQUIRE(pthread_join(thread, NULL) == 0);
+	pid_t child = fork();
+	REQUIRE(child >= 0);
+	if (child == 0) {
+		// An inherited FD is shared, but its tracing attachment is not inherited.
+		errno = 0;
+		if (ioctl(fd, KCOV_DISABLE, 0) != -1 || errno != EINVAL)
+			_exit(1);
+		errno = 0;
+		_exit(ioctl(fd, KCOV_ENABLE, 0) == -1 && errno == EBUSY ? 0 : 1);
+	}
+	int status;
+	REQUIRE(waitpid(child, &status, 0) == child);
+	REQUIRE(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+	REQUIRE(ioctl(fd, KCOV_DISABLE, 0) == 0);
+	__atomic_store_n(&area[0], 0, __ATOMIC_RELAXED);
+	(void)syscall(SYS_getpid);
+	REQUIRE(area[0] == 0);
+
+	// Task exit releases ownership even when a different task retains the FD.
+	child = fork();
+	REQUIRE(child >= 0);
+	if (child == 0)
+		_exit(ioctl(fd, KCOV_ENABLE, 0) == 0 ? 0 : 1);
+	REQUIRE(waitpid(child, &status, 0) == child);
+	REQUIRE(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+	REQUIRE(ioctl(fd, KCOV_ENABLE, 0) == 0);
+	REQUIRE(ioctl(fd, KCOV_DISABLE, 0) == 0);
+	REQUIRE(munmap((void *)area, ENTRIES * sizeof(long)) == 0);
+	REQUIRE(close(fd) == 0);
+	printf("PASS: real KCOV PCs, getpid=%lu getppid=%lu first_pc=%#lx; bounds, mmap, ownership, fork and exit checked\n",
+	       count, second_count, first_pc);
+	return 0;
+}
