@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MPL-2.0
+
+# Check the actual pinned compiler, not just the presence of build flags.
+set -euo pipefail
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+rustc=${RUSTC:-rustc}
+cat >"$work/probe.rs" <<'EOF'
+#![no_std]
+#[unsafe(no_mangle)]
+pub extern "C" fn branch(x: usize) -> usize {
+    if x > 7 { x / 3 } else { x + 9 }
+}
+EOF
+for crate in aster_core ostd; do
+    "$root/tools/kcov-rustc.sh" "$rustc" \
+        --crate-name "$crate" --crate-type lib --target x86_64-unknown-none \
+        --emit=obj -C opt-level=1 "$work/probe.rs" -o "$work/$crate.o"
+done
+nm -u "$work/aster_core.o" | grep -q __sanitizer_cov_trace_pc
+if nm -u "$work/ostd.o" | grep -q __sanitizer_cov_trace_pc; then
+    printf 'FAIL: the coverage runtime would be instrumented\n' >&2
+    exit 1
+fi
+printf 'PASS: safe kernel gets trace-pc callbacks; OSTD remains uninstrumented\n'
