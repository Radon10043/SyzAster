diff --git a/test/initramfs/src/apps/process/set_tid_address.c b/test/initramfs/src/apps/process/set_tid_address.c
new file mode 100644
index 000000000..ef3e4700d
--- /dev/null
+++ b/test/initramfs/src/apps/process/set_tid_address.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MPL-2.0
+
+#define _GNU_SOURCE
+
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include "../common/test.h"
+
+FN_TEST(replace_clear_child_tid)
+{
+	int first = 123;
+	int second = 456;
+	long tid = syscall(SYS_gettid);
+
+	TEST_RES(syscall(SYS_set_tid_address, &first), _ret == tid);
+	TEST_RES(syscall(SYS_set_tid_address, &second), _ret == tid);
+	TEST_RES(first, _ret == 123);
+	TEST_RES(second, _ret == 456);
+	TEST_RES(syscall(SYS_set_tid_address, NULL), _ret == tid);
+}
+END_TEST()
