diff --git a/distro/aster_nixos_installer/templates/install_nixos.sh b/distro/aster_nixos_installer/templates/install_nixos.sh
index 58c69aa11..f47abaa1f 100644
--- a/distro/aster_nixos_installer/templates/install_nixos.sh
+++ b/distro/aster_nixos_installer/templates/install_nixos.sh
@@ -89,11 +89,48 @@ else
     BOOT_DEVICE="${DISK}1"
     ROOT_DEVICE="${DISK}2"
 fi
-if [ ! -b "${BOOT_DEVICE}" ] && [ ! -b "${ROOT_DEVICE}" ]; then
+create_block_device_node() {
+    device_path="$1"
+    device_name="${device_path#/dev/}"
+    sysfs_dev="/sys/class/block/${device_name}/dev"
+    if [ ! -b "${device_path}" ] && [ -r "${sysfs_dev}" ]; then
+        IFS=: read -r major minor < "${sysfs_dev}"
+        mknod "${device_path}" b "${major}" "${minor}"
+    fi
+}
+
+remove_stale_block_device_node() {
+    device_path="$1"
+    device_name="${device_path#/dev/}"
+    if [ -b "${device_path}" ] && [ ! -e "/sys/class/block/${device_name}" ]; then
+        rm -f "${device_path}"
+    fi
+}
+
+remove_stale_block_device_node "${BOOT_DEVICE}"
+remove_stale_block_device_node "${ROOT_DEVICE}"
+
+if [ ! -b "${BOOT_DEVICE}" ] || [ ! -b "${ROOT_DEVICE}" ]; then
     parted ${DISK} -- mklabel gpt
     parted ${DISK} -- mkpart ESP fat32 1MB 512MB
     parted ${DISK} -- mkpart root ext2 512MB 100%
     parted ${DISK} -- set 1 esp on
+    for _ in $(seq 1 10); do
+        blockdev --rereadpt ${DISK} || true
+        partprobe ${DISK} || true
+        partx -a ${DISK} || partx -u ${DISK} || true
+        udevadm settle || true
+        create_block_device_node "${BOOT_DEVICE}"
+        create_block_device_node "${ROOT_DEVICE}"
+        if [ -b "${BOOT_DEVICE}" ] && [ -b "${ROOT_DEVICE}" ]; then
+            break
+        fi
+        sleep 0.2
+    done
+    if [ ! -b "${BOOT_DEVICE}" ] || [ ! -b "${ROOT_DEVICE}" ]; then
+        echo "Error: failed to create partition devices ${BOOT_DEVICE} and ${ROOT_DEVICE}" >&2
+        exit 1
+    fi
     echo "partition finished"
 
     mkfs.fat -F 32 -n boot "${BOOT_DEVICE}"
@@ -111,9 +148,11 @@ if findmnt -M ${BUILD_DIR} >/dev/null; then
 fi
 
 mkdir -p ${BUILD_DIR}
-mount -o sync,dirsync "${ROOT_DEVICE}" ${BUILD_DIR}
+mount -t ext2 -o sync,dirsync "${ROOT_DEVICE}" ${BUILD_DIR}
 
 mkdir -p ${BUILD_DIR}/boot
+mkdir -p ${BUILD_DIR}/tmp
+chmod 1777 ${BUILD_DIR}/tmp
 mkdir -p ${BUILD_DIR}/etc/nixos
 mount -o umask=077,sync,dirsync "${BOOT_DEVICE}" ${BUILD_DIR}/boot
 
@@ -131,9 +170,28 @@ cp @aster-configuration@ ${BUILD_DIR}/etc/nixos/aster_configuration.nix
 cp -r @aster-etc-nixos@/modules ${BUILD_DIR}/etc/nixos
 cp -r @aster-etc-nixos@/overlays ${BUILD_DIR}/etc/nixos
 
-export PATH=${PATH}:/run/current-system/sw/bin
-nixos-install --root ${BUILD_DIR} --no-root-passwd \
-    --option extra-substituters "@aster-substituters@" \
+COMMON_NIX_ARGS=(
+    --option extra-substituters "@aster-substituters@"
     --option extra-trusted-public-keys "@aster-trusted-public-keys@"
+)
+
+NIXPKGS_PATH="@aster-nixpkgs@"
+NIXOS_INSTALL="@nixos-install@"
+
+# Pre-build the NixOS system closure on the host
+# so that the result is cached in the host's Nix store.
+# Without this, nixos-install would build the system inside the (possibly empty) target image,
+# causing redundant downloads after every `make clean`.
+#
+# See: https://www.mankier.com/8/nixos-install#--system
+SYSTEM_CLOSURE=$(nix-build "${NIXPKGS_PATH}/nixos" -A system \
+    -I "nixos-config=${BUILD_DIR}/etc/nixos/configuration.nix" \
+    "${COMMON_NIX_ARGS[@]}" \
+    --no-out-link)
+
+export PATH=${PATH}:/run/current-system/sw/bin
+"${NIXOS_INSTALL}" --root ${BUILD_DIR} --no-root-passwd --no-channel-copy \
+    --system "${SYSTEM_CLOSURE}" \
+    "${COMMON_NIX_ARGS[@]}"
 
 echo "Congratulations! Asterinas NixOS has been installed successfully!"
\ No newline at end of file
