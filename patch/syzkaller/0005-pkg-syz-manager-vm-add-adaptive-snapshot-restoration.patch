+func TestBoundaryHardResetReplacesPreviousActionSample(t *testing.T) {
+	now := time.Now()
+	controller := &Controller{
+		policy: RestartPolicy{
+			decisionMode:         "bandit",
+			hardMax:              time.Hour,
+			maxSoftResets:        3,
+			maxConcurrentActions: 1,
+		},
+		feedback: make([]Feedback, 1),
+		learner:  newLinearUCB(0.1, 1),
+		states: []*VMState{{
+			pending: &learningSample{
+				action:    RestartSoft,
+				started:   now.Add(-time.Minute),
+				attempted: true,
+				learn:     true,
+			},
+		}},
