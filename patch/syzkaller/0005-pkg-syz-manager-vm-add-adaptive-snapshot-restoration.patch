+package adaptive
+
+import (
+	"github.com/google/syzkaller/pkg/report"
+	"github.com/google/syzkaller/pkg/report/crash"
+)
+
+// UsefulAdaCrash checks whether a crash is useful for adaptive mechanism
+func UsefulAdaCrash(rep *report.Report) bool {
+	if rep == nil || rep.Title == "" || rep.Suppressed {
+		return false
+	}
+	switch rep.Type {
+	case crash.LostConnection, crash.NoOutput, crash.SyzFailure:
+		return false
+	default:
+		return true
+	}
+}
diff --git a/pkg/adaptive/learning.go b/pkg/adaptive/learning.go
new file mode 100644
index 000000000..465b9693e
--- /dev/null
+++ b/pkg/adaptive/learning.go
@@ -0,0 +1,244 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package adaptive
+
+import (
+	"math"
+	"time"
+)
+
+const featureCount = 16
+
+type features [featureCount]float64
+
+type linearUCBModel struct {
+	matrix [featureCount][featureCount]float64
+	reward features
+	prior  features
+	count  uint64
+}
+
+type linearUCB struct {
+	models   map[RestartAct]*linearUCBModel
+	alpha    float64
+	discount float64
+}
+
+func newLinearUCB(alpha, discount float64) *linearUCB {
+	learner := &linearUCB{
+		models:   make(map[RestartAct]*linearUCBModel),
+		alpha:    alpha,
+		discount: discount,
+	}
+	for action := range RestartActionCount {
+		model := new(linearUCBModel)
+		for index := range featureCount {
+			model.matrix[index][index] = 1
+		}
+		model.prior[0] = map[RestartAct]float64{
+			RestartContinue:   0.25,
+			RestartCheckpoint: -0.10,
+			RestartSoft:       0,
+			RestartHard:       -0.50,
+		}[action]
+		model.reward = model.prior
+		learner.models[action] = model
+	}
+	return learner
+}
+
+// selectAction chooses an eligible action for the current context. It
+// prioritizes actions without a completed sample before selecting the action
+// with the highest UCB score.
+func (l *linearUCB) selectAction(feats features, actions []RestartAct,
+	tieBreaker float64) RestartAct {
+	if len(actions) == 0 {
+		return RestartContinue
+	}
+	start := int(tieBreaker * float64(len(actions)))
+	if start >= len(actions) {
+		start = len(actions) - 1
+	}
+	// A positive reward for the conservative continue action can otherwise
+	// dominate before any recovery action is sampled. Explore each action once
+	// while still respecting the caller's safety constraints.
+	for offset := range len(actions) {
+		action := actions[(start+offset)%len(actions)]
+		if l.models[action].count == 0 {
+			return action
+		}
+	}
+	best, bestScore := actions[start], math.Inf(-1)
+	for offset := range len(actions) {
+		action := actions[(start+offset)%len(actions)]
+		score := l.score(action, feats)
+		if score > bestScore {
+			best, bestScore = action, score
+		}
+	}
+	return best
+}
+
+// score returns an action's Linear-UCB score: its predicted reward plus an
+// exploration bonus proportional to prediction uncertainty.
+func (l *linearUCB) score(action RestartAct, feats features) float64 {
+	model := l.models[action]
+	inverse, ok := invertMatrix(model.matrix)
+	if !ok {
+		return math.Inf(1)
+	}
+	theta := multiplyMatrixVector(inverse, model.reward)
+	prediction := dotFeatures(theta, feats)
+	uncertaintyVector := multiplyMatrixVector(inverse, feats)
+	uncertainty := math.Sqrt(max(0, dotFeatures(feats, uncertaintyVector)))
+	return prediction + l.alpha*uncertainty
+}
+
+// update discounts every action model toward its prior, then records the
+// observed context and reward for the selected action.
+func (l *linearUCB) update(act RestartAct, feats features, reward float64) {
+	// Decay every action model on every observation. Decaying only the selected
+	// action leaves unselected actions with permanently stale estimates.
+	for _, model := range l.models {
+		for row := range featureCount {
+			for column := range featureCount {
+				identity := 0.0
+				if row == column {
+					identity = 1
+				}
+				model.matrix[row][column] =
+					identity + l.discount*(model.matrix[row][column]-identity)
+			}
+			model.reward[row] =
+				model.prior[row] + l.discount*(model.reward[row]-model.prior[row])
+		}
+	}
+	model := l.models[act]
+	for row := range featureCount {
+		for column := range featureCount {
+			model.matrix[row][column] += feats[row] * feats[column]
+		}
+		model.reward[row] += reward * feats[row]
+	}
+	model.count++
+}
+
+// multiplyMatrixVector returns the matrix-vector product.
+func multiplyMatrixVector(matrix [featureCount][featureCount]float64, vector features) features {
+	var result features
+	for row := range featureCount {
+		for column := range featureCount {
+			result[row] += matrix[row][column] * vector[column]
+		}
+	}
+	return result
+}
+
+// dotFeatures returns the dot product of two feature vectors.
+func dotFeatures(left, right features) float64 {
+	var result float64
+	for index := range featureCount {
+		result += left[index] * right[index]
+	}
+	return result
+}
+
+// invertMatrix uses Gauss-Jordan elimination with partial pivoting to return
+// the inverse and whether the matrix is sufficiently non-singular.
+func invertMatrix(input [featureCount][featureCount]float64) ([featureCount][featureCount]float64, bool) {
+	var augmented [featureCount][featureCount * 2]float64
+	for row := range featureCount {
+		for column := range featureCount {
+			augmented[row][column] = input[row][column]
+		}
+		augmented[row][featureCount+row] = 1
+	}
+	for pivot := range featureCount {
+		best := pivot
+		for row := pivot + 1; row < featureCount; row++ {
+			if math.Abs(augmented[row][pivot]) > math.Abs(augmented[best][pivot]) {
+				best = row
+			}
+		}
+		if math.Abs(augmented[best][pivot]) < 1e-12 {
+			return [featureCount][featureCount]float64{}, false
+		}
+		augmented[pivot], augmented[best] = augmented[best], augmented[pivot]
+		scale := augmented[pivot][pivot]
+		for column := range featureCount * 2 {
+			augmented[pivot][column] /= scale
+		}
+		for row := range featureCount {
+			if row == pivot {
+				continue
+			}
+			factor := augmented[row][pivot]
+			for column := range featureCount * 2 {
+				augmented[row][column] -= factor * augmented[pivot][column]
+			}
+		}
+	}
+	var inverse [featureCount][featureCount]float64
+	for row := range featureCount {
+		copy(inverse[row][:], augmented[row][featureCount:])
+	}
+	return inverse, true
+}
+
+type learningSample struct {
+	action    RestartAct
+	features  features
+	baseline  feedbackSnapshot
+	started   time.Time
+	cost      time.Duration
+	snapshot  string
+	learn     bool
+	attempted bool
+	failed    bool
+}
+
+// Reward returns the observed utility of an adaptive action. It rewards
+// time-normalized fuzzing progress and throughput, and penalizes unhealthy
+// executions, action downtime, and action failure.
+func Reward(delta feedbackSnapshot, elapsed, cost time.Duration, failed bool) float64 {
+	const minObs = time.Second
+	obsMinutes := max(elapsed, minObs).Minutes()
+	progress := 2*math.Log1p(float64(delta.newSignal)) +
+		5*math.Log1p(float64(delta.stableSignal)) +
+		8*float64(delta.newInputs) +
+		1.5*math.Log1p(stateNoveltyRate(delta)) +
+		25*float64(delta.uniqueCrashes)
+	progress /= obsMinutes
+	repCrashes := repeatedCrashCount(delta)
+	healthPenalty := (3*float64(delta.hangs+delta.failures) + float64(repCrashes)) /
+		obsMinutes
+	downtimePenalty := 0.0
+	if elapsed > 0 {
+		downtimePenalty = 10 * float64(cost) / float64(elapsed)
+	}
+	throughput := math.Log1p(float64(delta.execs)/obsMinutes) / 10
+	failurePenalty := 0.0
+	if failed {
+		failurePenalty = 50
+	}
+	return progress + throughput - healthPenalty - downtimePenalty - failurePenalty
+}
+
+// repeatedCrashCount returns crashes that were not newly unique, clamped to
+// zero because the two counters may be observed between concurrent updates.
+func repeatedCrashCount(window feedbackSnapshot) uint64 {
+	// Crash and unique-crash counters are updated separately. A concurrent
+	// snapshot can therefore observe the unique counter in the next window.
+	if window.crashes <= window.uniqueCrashes {
+		return 0
+	}
+	return window.crashes - window.uniqueCrashes
+}
+
+func stateNoveltyRate(window feedbackSnapshot) float64 {
+	if window.stateEvents == 0 {
+		return 0
+	}
+	return 1000 * float64(window.stateNovelty) / float64(window.stateEvents)
+}
