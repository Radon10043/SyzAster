+	}
+	decision := controller.onlineDecisionLocked(0, obs)
+	assert.Equal(t, RestartCheckpoint, decision.Action)
+	controller.prepareActionLocked(0, &decision)
+	controller.startLearningSampleLocked(controller.states[0], decision,
+		adaptiveFeaturesFor(obs), feedbackSnapshot{}, now)
+	controller.CompleteAction(0, decision, time.Second, true)
+	assert.Len(t, controller.states[0].bank.entries, 1)
+	if len(controller.states[0].bank.entries) != 0 {
+		assert.Equal(t, decision.SnapshotName, controller.states[0].bank.entries[0].name)
+	}
+}
