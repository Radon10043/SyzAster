+	controller.feedback[0].execs.Store(100)
+	decision := controller.AfterLease(0, now, 3)
+	assert.Equal(t, RestartHard, decision.Action)
+	assert.Equal(t, uint64(1), controller.learner.models[RestartSoft].count)
+	assert.NotNil(t, controller.states[0].pending)
+	assert.Equal(t, RestartHard, controller.states[0].pending.action)
+	assert.False(t, controller.states[0].pending.attempted)
