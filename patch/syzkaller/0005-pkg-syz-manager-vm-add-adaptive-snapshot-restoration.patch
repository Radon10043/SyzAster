+#include "textflag.h"
+
+// func rdtsc() uint64
+//
+// Reads the x86 time-stamp counter. RDTSC returns the low 32 bits in EAX and
+// the high 32 bits in EDX, so they are recombined into a single uint64. The
+// leading LFENCE prevents RDTSC from being reordered ahead of the loads that
+// bracket it in the calibration loop, keeping each sample tightly bounded.
+TEXT ·rdtsc(SB), NOSPLIT, $0-8
+	LFENCE
+	RDTSC
+	SHLQ	$32, DX
+	ORQ	DX, AX
+	MOVQ	AX, ret+0(FP)
+	RET
