+				entries: []Snapshot{{name: "same", fingerprint: fingerprint}},
+			},
+		}},
+	}
+	obs := restartObservation{
+		fingerprint: fingerprint,
+		window:      feedbackSnapshot{stateNovelty: 100},
+	}
+	assert.False(t, controller.canPromoteLocked(0, obs))
+
+	controller.states[0].bank.entries = nil
+	assert.True(t, controller.canPromoteLocked(0, obs))
+}
+
+func TestPromotionRemainsReachableAfterNoveltyCacheStabilizes(t *testing.T) {
+	controller := &Controller{
+		policy: RestartPolicy{
+			snapshotBankSize:        2,
+			statePromotionThreshold: 8,
+		},
+		states: []*VMState{{}},
+	}
