+func TestStateFingerprintRestore(t *testing.T) {
+	var sketch stateSketch
+	sketch.record(1, 1)
+	first := sketch.snapshot()
+	sketch.record(2, 1)
+	novelty := sketch.novelty.Load()
+	assert.Greater(t, sketch.snapshot().distance(first), uint64(0))
+	sketch.restore(first)
+	assert.Zero(t, sketch.snapshot().distance(first))
+	sketch.restore(stateFingerprint{})
+	sketch.record(1, 1)
+	assert.Equal(t, novelty, sketch.novelty.Load(),
+		"restoring an old state must not make replayed behavior novel again")
+}
+
+func TestStateFingerprintDoesNotSaturateToOneValue(t *testing.T) {
+	var left, right stateSketch
+	for digest := uint64(1); digest <= 10_000; digest++ {
+		left.record(digest, 1)
+		right.record(digest+10_000, 1)
+	}
+	assert.Equal(t, uint64(stateFingerprintWords), left.snapshot().count())
+	assert.Positive(t, left.snapshot().depth())
+	assert.Greater(t, left.snapshot().distance(right.snapshot()), uint64(0),
+		"long-running behavioral signatures must remain distinguishable")
+}
