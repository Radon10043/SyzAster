+func TestAdaptiveRestartMonitor(t *testing.T) {
+	controller := &Controller{
+		policy: RestartPolicy{
+			decisionMode:      "heuristic",
+			minLease:          time.Millisecond,
+			maxLease:          5 * time.Millisecond,
+			hardMax:           time.Hour,
+			stall:             time.Hour,
+			evaluation:        time.Millisecond,
+			maxSoftResets:     5,
+			throughputDropPct: 50,
+			unhealthy:         3,
+		},
+		feedback: make([]Feedback, 1),
+		states:   []*VMState{{}},
+		random: []random{{
+			rnd: rand.New(rand.NewSource(1)),
+		}},
+	}
+	ctx, cancel, decisions := controller.StartLease(context.Background(), 0, time.Now(), 0)
+	defer cancel()
+	select {
+	case decision := <-decisions:
+		assert.Equal(t, RestartSoft, decision.Action)
+		assert.Equal(t, RestartReasonLeaseLimit, decision.Reason)
+	case <-time.After(time.Second):
+		t.Fatal("adaptive restart monitor did not make a decision")
+	}
+	<-ctx.Done()
+}
