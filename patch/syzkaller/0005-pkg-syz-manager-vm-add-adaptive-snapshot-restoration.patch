+func TestEvaluateAdaptiveRestart(t *testing.T) {
+	now := time.Now()
+	policy := RestartPolicy{
+		minLease:          10 * time.Minute,
+		maxLease:          time.Hour,
+		hardMax:           6 * time.Hour,
+		stall:             20 * time.Minute,
+		maxSoftResets:     5,
+		throughputDropPct: 50,
+		unhealthy:         3,
+	}
+	base := restartObservation{
+		now:              now,
+		vmStarted:        now.Add(-time.Hour),
+		leaseStarted:     now.Add(-30 * time.Minute),
+		lastProgress:     now.Add(-5 * time.Minute),
+		peerLastProgress: now.Add(-5 * time.Minute),
+		leaseLimit:       time.Hour,
+		random:           1,
+	}
+	tests := []struct {
+		name   string
+		mutate func(*restartObservation)
+		action RestartAct
+		reason RestartReason
+	}{
+		{
+			name: "continue",
+		},
+		{
+			name: "vm lifetime",
+			mutate: func(obs *restartObservation) {
+				obs.vmStarted = now.Add(-policy.hardMax)
+			},
+			action: RestartHard,
+			reason: RestartReasonVMLifetime,
+		},
+		{
+			name: "unhealthy before minimum lease",
+			mutate: func(obs *restartObservation) {
+				obs.leaseStarted = now.Add(-time.Minute)
+				obs.window.execs = 100
+				obs.window.hangs = policy.unhealthy
+			},
+		},
+		{
+			name: "unhealthy after minimum lease",
+			mutate: func(obs *restartObservation) {
+				obs.window.execs = 100
+				obs.window.hangs = policy.unhealthy
+			},
+			action: RestartSoft,
+			reason: RestartReasonUnhealthy,
+		},
+		{
+			name: "executor restarts are not unhealthy",
+			mutate: func(obs *restartObservation) {
+				obs.window.execs = 100
+				obs.window.restarts = 100
+			},
+		},
+		{
+			name: "throughput degraded",
+			mutate: func(obs *restartObservation) {
+				obs.lowThroughputWindows = 3
+			},
+			action: RestartSoft,
+			reason: RestartReasonThroughput,
+		},
+		{
+			name: "lease limit",
+			mutate: func(obs *restartObservation) {
+				obs.leaseStarted = now.Add(-2 * time.Hour)
+			},
+			action: RestartSoft,
+			reason: RestartReasonLeaseLimit,
+		},
+		{
+			name: "peer progress increases stall reset probability",
+			mutate: func(obs *restartObservation) {
+				obs.lastProgress = now.Add(-policy.stall)
+				obs.peerLastProgress = now
+				obs.random = 0.2
+			},
+			action: RestartSoft,
+			reason: RestartReasonStalled,
+		},
+		{
+			name: "force reset after three stall periods",
+			mutate: func(obs *restartObservation) {
+				obs.lastProgress = now.Add(-3 * policy.stall)
+			},
+			action: RestartSoft,
+			reason: RestartReasonStalled,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			obs := base
+			if test.mutate != nil {
+				test.mutate(&obs)
+			}
+			decision := evaluateAdaptiveRestart(obs, policy)
+			assert.Equal(t, test.action, decision.Action)
+			assert.Equal(t, test.reason, decision.Reason)
+		})
+	}
+}
