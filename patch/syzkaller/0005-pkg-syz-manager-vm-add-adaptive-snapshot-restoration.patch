+
+	controller.states[0].bank.entries = []Snapshot{{
+		name:        "near",
+		fingerprint: obs.fingerprint,
+	}}
+	obs.fingerprint[0] = 2
+	assert.False(t, controller.canPromoteLocked(0, obs),
+		"a nearly identical state must not churn the snapshot bank")
+
+	for index := range statePromotionMinDistance {
+		obs.fingerprint[index] = uint64(index + 10)
+	}
+	assert.True(t, controller.canPromoteLocked(0, obs),
+		"useful behaviorally distinct states must remain promotable")
+}
+
+func TestHeuristicPromotionRequiresNoveltyThreshold(t *testing.T) {
