index 000000000..2150db87b
--- /dev/null
+++ b/pkg/adaptive/state.go
@@ -0,0 +1,345 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package adaptive
+
+import (
+	"math"
+	"math/rand"
+	"slices"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	stateFingerprintDepthWords  = 64
+	stateFingerprintRecentWords = 64
+	stateFingerprintWords       = stateFingerprintDepthWords + stateFingerprintRecentWords
+	stateNoveltySlots           = 4096
+	statePromotionMinDistance   = stateFingerprintRecentWords / 4
+)
+
+type stateFingerprint [stateFingerprintWords]uint64
+
+// count returns the number of initialized registers in the fingerprint.
+func (f stateFingerprint) count() uint64 {
+	var total uint64
+	for _, word := range f {
+		if word != 0 {
+			total++
+		}
+	}
+	return total
+}
+
+// distance returns the number of registers that differ between two fingerprints.
+func (f stateFingerprint) distance(other stateFingerprint) uint64 {
+	var total uint64
+	for index, word := range f {
+		if word != other[index] {
+			total++
+		}
+	}
+	return total
+}
+
+// depth estimates accumulated behavioral depth from the long-term MinHash registers.
+func (f stateFingerprint) depth() float64 {
+	var total float64
+	var samples uint64
+	scale := float64(^uint64(0))
+	for _, word := range f[:stateFingerprintDepthWords] {
+		if word == 0 {
+			continue
+		}
+		// MinHash register minima decrease as more distinct behavior reaches the
+		// state. The negative log yields a stable, non-saturating depth proxy.
+		total -= math.Log(float64(word) / scale)
+		samples++
+	}
+	if samples == 0 {
+		return 0
+	}
+	return total / float64(samples)
+}
+
+// digest returns a compact deterministic hash of the complete fingerprint.
+func (f stateFingerprint) digest() uint64 {
+	const prime = uint64(1099511628211)
+	hash := uint64(14695981039346656037)
+	for _, word := range f {
+		hash ^= word
+		hash *= prime
+	}
+	return hash
+}
+
+type stateSketch struct {
+	// The first half of words is a MinHash-style long-term depth signature. The
+	// second half is a direct-mapped recent-behavior signature that keeps
+	// snapshot distance and duplicate detection responsive after the MinHash
+	// minima stop changing frequently. Both halves are restored with a snapshot.
+	// recent is a larger campaign-local cache used only for novelty counting; it
+	// is never restored, so immediately replaying a snapshot does not manufacture
+	// novelty.
+	words   [stateFingerprintWords]atomic.Uint64
+	recent  [stateNoveltySlots]atomic.Uint64
+	novelty atomic.Uint64
+	events  atomic.Uint64
+}
+
+// record adds observed behavior to the campaign-local novelty cache and the
+// restorable hybrid state fingerprint.
+func (sketch *stateSketch) record(digest, events uint64) {
+	if digest == 0 {
+		return
+	}
+	sketch.events.Add(max(uint64(1), events))
+	slot := mixStateDigest(digest^0x243f6a8885a308d3) % stateNoveltySlots
+	tag := mixStateDigest(digest ^ 0x13198a2e03707344)
+	if tag == 0 {
+		tag = 1
+	}
+	if sketch.recent[slot].Swap(tag) != tag {
+		sketch.novelty.Add(1)
+	}
+	// Four independently mixed register pairs form a compact behavioral-state
+	// signature without adding per-execution locking.
+	for round := range 4 {
+		digest = mixStateDigest(digest + uint64(round)*0x9e3779b97f4a7c15)
+		index := digest % stateFingerprintDepthWords
+		value := mixStateDigest(digest ^ 0xd6e8feb86659fd93)
+		if value == 0 {
+			value = 1
+		}
+		setStateSketchMin(&sketch.words[index], value)
+		recentIndex := stateFingerprintDepthWords +
+			mixStateDigest(digest^0xa4093822299f31d0)%stateFingerprintRecentWords
+		recentValue := mixStateDigest(digest ^ 0x082efa98ec4e6c89)
+		if recentValue == 0 {
+			recentValue = 1
+		}
+		sketch.words[recentIndex].Store(recentValue)
+	}
+}
+
+// setStateSketchMin atomically stores value when it is the first or a smaller
+// MinHash register value, and reports whether the register changed.
+func setStateSketchMin(word *atomic.Uint64, value uint64) bool {
+	for {
+		old := word.Load()
+		if old != 0 && old <= value {
+			return false
+		}
+		if word.CompareAndSwap(old, value) {
+			return true
+		}
+	}
+}
+
+// mixStateDigest deterministically disperses a state digest into a 64-bit value.
+func mixStateDigest(value uint64) uint64 {
+	value ^= value >> 30
+	value *= 0xbf58476d1ce4e5b9
+	value ^= value >> 27
+	value *= 0x94d049bb133111eb
+	return value ^ (value >> 31)
+}
+
+// snapshot returns an atomic view of the restorable fingerprint registers.
+func (sketch *stateSketch) snapshot() stateFingerprint {
+	var fingerprint stateFingerprint
+	for index := range fingerprint {
+		fingerprint[index] = sketch.words[index].Load()
+	}
+	return fingerprint
+}
+
+// restore replaces the restorable fingerprint while preserving campaign-local
+// novelty counters and cache contents.
+func (sketch *stateSketch) restore(fingerprint stateFingerprint) {
+	for index, word := range fingerprint {
+		sketch.words[index].Store(word)
+	}
+}
+
+type Snapshot struct {
+	name          string
+	created       time.Time
+	stateAge      time.Duration
+	fingerprint   stateFingerprint
+	value         float64
+	novelty       uint64
+	uses          uint64
+	reward        float64
+	rewardSamples uint64
+	// Intermediate snapshots whose saved state this snapshot's state extends.
+	ancestors []string
+
+	promotionFeatures features
+	promotionLearn    bool
+}
+
+type snapshotBank struct {
+	clean   Snapshot
+	entries []Snapshot
+	nextID  uint64
+}
+
+// reset replaces the clean snapshot and clears all retained intermediate snapshots.
+func (bank *snapshotBank) reset(cleanName string, now time.Time) {
+	bank.clean = Snapshot{
+		name:    cleanName,
+		created: now,
+	}
+	bank.entries = nil
+	bank.nextID = 0
+}
+
+// find returns the clean or intermediate snapshot with the requested name.
+func (bank *snapshotBank) find(name string) *Snapshot {
+	if bank.clean.name == name {
+		return &bank.clean
+	}
+	for index := range bank.entries {
+		if bank.entries[index].name == name {
+			return &bank.entries[index]
+		}
+	}
+	return nil
+}
+
+// lineage returns the intermediate snapshots a state restored from this
+// snapshot descends from, including the snapshot itself.
+func (s *Snapshot) lineage() []string {
+	if s.name == CleanSnapshotName {
+		return nil
+	}
+	return append(slices.Clone(s.ancestors), s.name)
+}
+
+// selectRandom returns a randomly selected snapshot from the snapshot bank,
+// chosen uniformly among intermediate snapshots not named in excluded,
+// falling back to clean when no intermediate snapshots are eligible.
+func (bank *snapshotBank) selectRandom(excluded []string, rnd float64) *Snapshot {
+	var candidates []*Snapshot
+	for index := range bank.entries {
+		entry := &bank.entries[index]
+		if slices.Contains(excluded, entry.name) {
+			continue
+		}
+		candidates = append(candidates, entry)
+	}
+	if len(candidates) == 0 {
+		return &bank.clean
+	}
+	if len(candidates) == 1 {
+		return candidates[0]
+	}
+	if rnd < 0 || rnd >= 1 {
+		rnd = rand.Float64()
+	}
+	idx := int(rnd * float64(len(candidates)))
+	if idx >= len(candidates) {
+		idx = len(candidates) - 1
+	}
+	return candidates[idx]
+}
+
+// selectFor returns a randomly selected snapshot from the snapshot bank.
+func (bank *snapshotBank) selectFor(current stateFingerprint) *Snapshot {
+	return bank.selectRandom(nil, rand.Float64())
+}
+
+// selectExcluding returns a randomly selected snapshot from the snapshot bank
+// among clean and intermediate snapshots not named in excluded.
+func (bank *snapshotBank) selectExcluding(current stateFingerprint, excluded []string) *Snapshot {
+	return bank.selectRandom(excluded, rand.Float64())
+}
+
+// containsFingerprint reports whether the bank already retains an identical fingerprint.
+func (bank *snapshotBank) containsFingerprint(fingerprint stateFingerprint) bool {
+	if bank.clean.fingerprint == fingerprint {
+		return true
+	}
+	for _, entry := range bank.entries {
+		if entry.fingerprint == fingerprint {
+			return true
+		}
+	}
+	return false
+}
+
+// closestDistance returns the minimum register distance to an intermediate snapshot.
+func (bank *snapshotBank) closestDistance(fingerprint stateFingerprint) uint64 {
+	if len(bank.entries) == 0 {
+		return stateFingerprintWords
+	}
+	distance := uint64(stateFingerprintWords)
+	for _, entry := range bank.entries {
+		distance = min(distance, entry.fingerprint.distance(fingerprint))
+	}
+	return distance
+}
+
+// snapshotScore estimates restoration utility from learned reward, state value,
+// novelty, depth, active age, and distance from the current state.
+func snapshotScore(s Snapshot, current stateFingerprint) float64 {
+	distance := 0.0
+	if s.name != CleanSnapshotName {
+		distance = float64(s.fingerprint.distance(current)) / 4
+	}
+	// Count only active state age accumulated before save; frozen wall time
+	// must not make a retained snapshot appear more valuable.
+	return s.value + s.reward + float64(s.novelty)/10 +
+		s.fingerprint.depth() + s.stateAge.Hours() + distance
+}
+
+// observe updates the snapshot's exponentially weighted reward estimate.
+func (s *Snapshot) observe(reward float64) {
+	const weight = 0.2
+	if s.rewardSamples == 0 {
+		s.reward = reward
+	} else {
+		s.reward = (1-weight)*s.reward + weight*reward
+	}
+	s.rewardSamples++
+}
+
+// snapshotRetentionScore estimates a snapshot's value for bank retention
+// without considering distance from the current state.
+func snapshotRetentionScore(s Snapshot) float64 {
+	return s.value + s.reward + float64(s.novelty)/10 +
+		s.fingerprint.depth() + s.stateAge.Hours()
+}
+
+// evictionCandidate returns the lowest-retention intermediate snapshot when
+// the bank has reached its configured capacity.
+func (bank *snapshotBank) evictionCandidate(maxEntries int) string {
+	if maxEntries <= 0 || len(bank.entries) == 0 || len(bank.entries) < maxEntries {
+		return ""
+	}
+	evict := 0
+	for index := 1; index < len(bank.entries); index++ {
+		left, right := bank.entries[index], bank.entries[evict]
+		if snapshotRetentionScore(left) < snapshotRetentionScore(right) {
+			evict = index
+		}
+	}
+	return bank.entries[evict].name
+}
+
+// remove deletes the named intermediate snapshot from the bank metadata.
+func (bank *snapshotBank) remove(name string) {
+	for index := range bank.entries {
+		if bank.entries[index].name == name {
+			bank.entries = append(bank.entries[:index], bank.entries[index+1:]...)
+			return
+		}
+	}
+}
+
+// append adds an intermediate snapshot to the bank metadata.
+func (bank *snapshotBank) append(s Snapshot) {
+	bank.entries = append(bank.entries, s)
+}
