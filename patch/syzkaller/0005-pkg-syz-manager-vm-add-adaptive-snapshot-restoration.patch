+func TestStateFingerprintRemainsResponsiveInLongCampaign(t *testing.T) {
+	var sketch stateSketch
+	for digest := uint64(1); digest <= 10_000; digest++ {
+		sketch.record(digest, 1)
+	}
+	first := sketch.snapshot()
+	for digest := uint64(10_001); digest <= 20_000; digest++ {
+		sketch.record(digest, 1)
+	}
+	assert.Greater(t, sketch.snapshot().distance(first), uint64(0),
+		"recent-behavior registers must keep snapshot fingerprints distinguishable")
+}
