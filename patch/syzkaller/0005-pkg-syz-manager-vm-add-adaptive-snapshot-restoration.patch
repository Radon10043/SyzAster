diff --git a/pkg/tsc/tsc.go b/pkg/tsc/tsc.go
new file mode 100644
index 000000000..c15a87cd3
--- /dev/null
+++ b/pkg/tsc/tsc.go
@@ -0,0 +1,157 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+// Package tsc determines the host CPU's time-stamp counter (TSC) frequency,
+// which is needed to pin QEMU's tsc-frequency so restored snapshot guests
+// observe a stable counter rate. It is only meaningful on amd64.
+package tsc
+
+import (
+	"fmt"
+	"os/exec"
+	"regexp"
+	"runtime"
+	"slices"
+	"strconv"
+	"time"
+
+	"github.com/google/syzkaller/pkg/log"
+)
+
+// Frequency returns the host TSC frequency in Hz. It prefers the exact nominal
+// value reported by Intel via CPUID leaf 0x15 and falls back to empirically
+// calibrating the counter against a monotonic clock. Calibration is the only
+// option on AMD, which does not populate leaf 0x15, and on older Intel parts
+// that lack it.
+func Frequency() (uint64, error) {
+	if freq, err := fromCPUID(); err == nil {
+		return freq, nil
+	} else {
+		log.Logf(0, "cpuid-based TSC frequency unavailable (%v), "+
+			"falling back to RDTSC calibration", err)
+	}
+	return calibrate()
+}
+
+// fromCPUID derives the nominal TSC frequency from CPUID leaf 0x15, which Intel
+// populates with the core crystal clock and the TSC/clock ratio.
+func fromCPUID() (uint64, error) {
+	out, err := exec.Command("cpuid", "-1", "-l", "0x15").Output()
+	if err != nil {
+		return 0, fmt.Errorf("failed to run cpuid: %w", err)
+	}
+	return parseCPUID(string(out))
+}
+
+func parseCPUID(output string) (uint64, error) {
+	ratioRegexp := regexp.MustCompile(`TSC/clock ratio\s*=\s*(\d+)/(\d+)`)
+	clockRegexp := regexp.MustCompile(`nominal core crystal clock\s*=\s*(\d+)\s*Hz`)
+	ratioMatch := ratioRegexp.FindStringSubmatch(output)
+	clockMatch := clockRegexp.FindStringSubmatch(output)
+	if len(ratioMatch) != 3 || len(clockMatch) != 2 {
+		return 0, fmt.Errorf(
+			"failed to parse cpuid output, len(ratioMatch)=%d, len(clockMatch)=%d",
+			len(ratioMatch), len(clockMatch),
+		)
+	}
+
+	numerator, err := strconv.ParseUint(ratioMatch[1], 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("failed to parse TSC ratio numerator: %w", err)
+	}
+	denominator, err := strconv.ParseUint(ratioMatch[2], 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("failed to parse TSC ratio denominator: %w", err)
+	}
+	clock, err := strconv.ParseUint(clockMatch[1], 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("failed to parse nominal core crystal clock: %w", err)
+	}
+	// AMD (and some older Intel parts) report zeros here; treat that as "not
+	// available" so the caller can fall back to calibration.
+	if numerator == 0 || denominator == 0 || clock == 0 {
+		return 0, fmt.Errorf("cpuid leaf 0x15 reports no crystal clock (ratio=%d/%d, clock=%d)",
+			numerator, denominator, clock)
+	}
+	if clock > ^uint64(0)/numerator {
+		return 0, fmt.Errorf("TSC frequency calculation overflows uint64")
+	}
+	tscfreq := clock * numerator / denominator
+	if tscfreq == 0 {
+		return 0, fmt.Errorf("calculated TSC frequency is zero")
+	}
+	return tscfreq, nil
+}
+
+// calibrate measures the TSC frequency empirically by reading the counter
+// across a fixed wall-clock window. This is vendor independent and is the only
+// option on AMD, which exposes no nominal TSC frequency via CPUID.
+func calibrate() (uint64, error) {
+	if invariant, err := invariantSupported(); err == nil && !invariant {
+		log.Logf(0, "warning: CPU does not advertise an invariant TSC; "+
+			"the calibrated frequency may drift with the core clock")
+	}
+
+	// Keep the goroutine on a single OS thread to reduce scheduling noise.
+	// Cross-core consistency is guaranteed by the invariant TSC.
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+
+	const (
+		warmup = 20 * time.Millisecond
+		window = 100 * time.Millisecond
+		rounds = 5
+	)
+
+	// Let caches/branch predictors settle and the CPU ramp up before sampling.
+	time.Sleep(warmup)
+
+	samples := make([]uint64, 0, rounds)
+	for range rounds {
+		if f := measure(window); f != 0 {
+			samples = append(samples, f)
+		}
+	}
+	if len(samples) == 0 {
+		return 0, fmt.Errorf("TSC calibration produced no valid samples")
+	}
+
+	// The median rejects outliers from a sample whose bracket happened to
+	// straddle a context switch or interrupt.
+	slices.Sort(samples)
+	return samples[len(samples)/2], nil
+}
+
+// measure returns the average TSC rate (Hz) over window, or 0 on a degenerate
+// measurement. The monotonic clock and the counter are sampled in the same
+// order at both ends, so the constant read latency between the two cancels out
+// and does not bias the result.
+func measure(window time.Duration) uint64 {
+	t0 := time.Now()
+	c0 := rdtsc()
+	time.Sleep(window)
+	t1 := time.Now()
+	c1 := rdtsc()
+
+	elapsed := t1.Sub(t0).Seconds()
+	if elapsed <= 0 || c1 <= c0 {
+		return 0
+	}
+	return uint64(float64(c1-c0)/elapsed + 0.5)
+}
+
+// invariantSupported reports whether CPUID leaf 0x80000007 advertises an
+// invariant (constant-rate) TSC. A missing cpuid tool is reported as an error
+// rather than a definitive "false".
+func invariantSupported() (bool, error) {
+	out, err := exec.Command("cpuid", "-1", "-l", "0x80000007").Output()
+	if err != nil {
+		return false, fmt.Errorf("failed to run cpuid: %w", err)
+	}
+	re := regexp.MustCompile(`TscInvariant\s*=\s*(true|false)`)
+	m := re.FindStringSubmatch(string(out))
+	if len(m) != 2 {
+		return false, fmt.Errorf("could not find TscInvariant flag in cpuid output")
+	}
+	return m[1] == "true", nil
+}
