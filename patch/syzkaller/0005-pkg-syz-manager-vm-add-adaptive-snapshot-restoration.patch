+func (mgr *Manager) crashSnapshotInstance(ctx context.Context, inst *vm.Instance, serv rpcserver.Server,
+	updInfo dispatcher.UpdateInfo) {
+	if serv == nil {
+		return
+	}
+	mgr.recordRestartTimes(inst.Index(), inst.BootTime())
+	updInfo(func(info *dispatcher.Info) {
+		info.Status = "saving clean snapshot"
+	})
+	fwdAddr, executorBin, err := mgr.prepareInstanceForFuzzing(inst)
+	if err != nil {
+		log.Logf(1, "VM %v: failed to prepare crash snapshot: %v", inst.Index(), err)
+		return
+	}
+	start := time.Now()
+	if err := inst.SaveSnapshot(ada.CleanSnapshotName); err != nil {
+		mgr.recordSnapshotSaveTime(inst.Index(), time.Since(start))
+		log.Logf(1, "VM %v: failed to save clean snapshot: %v", inst.Index(), err)
+		return
+	}
+	saveTime := time.Since(start)
+	mgr.recordSnapshotSave(inst.Index(), saveTime)
+	if mgr.adaController != nil {
+		mgr.adaController.RegisterCleanSnapshot(inst.Index(), inst.BootTime()+saveTime)
+	}
+	log.Logf(0, "VM %v: saved clean snapshot", inst.Index())
+
+	vmStarted := time.Now()
+	softResets := 0
+	for ctx.Err() == nil {
+		if mgr.adaController != nil {
+			decision := mgr.adaController.BeforeLease(inst.Index(), vmStarted, softResets)
+			if decision.Action == ada.RestartHard {
+				mgr.adaController.ForcedHardReset(inst.Index())
+				mgr.adaController.RecordDecision(decision)
+				log.Logf(0, "VM %v: adaptive restart decision: %v", inst.Index(), decision)
+				return
+			}
+		}
+		updInfo(func(info *dispatcher.Info) {
+			info.Status = "snapshot fuzzing"
+		})
+		injectExec := make(chan bool, 10)
+		serv.CreateInstance(inst.Index(), injectExec, makeRPCUpdateInfo(updInfo))
+		runCtx, stopLease := ctx, func() {}
+		var decisions <-chan ada.RestartDecision
+		runDuration := mgr.cfg.Timeouts.VMRunningTime
+		if mgr.adaController != nil {
+			runCtx, stopLease, decisions = mgr.adaController.StartLease(ctx, inst.Index(), vmStarted, softResets)
+			runDuration = mgr.adaController.HardMax()
+		}
+		reps, vmInfo, err := mgr.runInstanceWithExecutorFor(runCtx, runDuration, inst, fwdAddr, executorBin,
+			vm.WithExitCondition(vm.ExitTimeout),
+			vm.WithInjectExecuting(injectExec),
+			vm.WithEarlyFinishCb(func() {
+				// Depending on the crash type and kernel config, fuzzing may continue
+				// running for several seconds even after kernel has printed a crash report.
+				// This litters the log, and we want to prevent it.
+				serv.StopFuzzing(inst.Index())
+			}))
+		stopLease()
+		var decision ada.RestartDecision
+		if decisions != nil {
+			select {
+			case decision = <-decisions:
+			default:
+			}
+		}
+		if err := mgr.finishFuzzerRun(serv, inst, reps, vmInfo, err); err != nil || ctx.Err() != nil {
+			return
+		}
+		if mgr.adaController != nil && len(reps) != 0 && decision.Action != ada.RestartHard {
+			// A crash can race with a policy decision. Never checkpoint the
+			// crashed state or apply a restore chosen before the crash. Drop
+			// the censored policy action and force crash recovery, which picks
+			// clean or a snapshot outside the crashed state's lineage.
+			decision = mgr.adaController.RecoveryDecision(inst.Index(), true)
+		}
+		if decision.Action == ada.RestartHard {
+			mgr.adaController.RecordDecision(decision)
+			log.Logf(0, "VM %v: adaptive restart decision: %v", inst.Index(), decision)
+			return
+		}
+		if mgr.adaController != nil {
+			afterDecision := mgr.adaController.AfterLease(inst.Index(), vmStarted, softResets)
+			if afterDecision.Action == ada.RestartHard {
+				// AfterLease transfers an existing action reservation to the hard
+				// reset, so keep it until the replacement VM registers its clean
+				// snapshot.
+				mgr.adaController.ForcedHardReset(inst.Index())
+				mgr.adaController.RecordDecision(afterDecision)
+				log.Logf(0, "VM %v: adaptive restart decision: %v", inst.Index(), afterDecision)
+				return
+			}
+		}
+		if decision.Action == ada.RestartCheckpoint {
+			mgr.adaController.RecordDecision(decision)
+			log.Logf(0, "VM %v: adaptive restart decision: %v", inst.Index(), decision)
+			saveTime, err := promoteSnapshot(inst, decision.SnapshotName, decision.DeleteSnapshot)
+			if err != nil {
+				mgr.adaController.CompleteAction(inst.Index(), decision, saveTime, false)
+				mgr.recordSnapshotSaveTime(inst.Index(), saveTime)
+				log.Logf(1, "VM %v: failed to promote snapshot %q: %v",
+					inst.Index(), decision.SnapshotName, err)
+				return
+			}
+			mgr.adaController.CompleteAction(inst.Index(), decision, saveTime, true)
+			mgr.recordSnapshotSave(inst.Index(), saveTime)
+			log.Logf(0, "VM %v: promoted snapshot %q in %v", inst.Index(), decision.SnapshotName, saveTime)
+			continue
+		}
+		if decision.Action == ada.RestartContinue && mgr.adaController != nil {
+			decision = mgr.adaController.RecoveryDecision(inst.Index(), len(reps) != 0)
+		}
+		if decision.Action == ada.RestartSoft {
+			mgr.adaController.RecordDecision(decision)
+			log.Logf(0, "VM %v: adaptive restart decision: %v", inst.Index(), decision)
+		}
+		updInfo(func(info *dispatcher.Info) {
+			info.Status = "restoring snapshot"
+		})
+		start := time.Now()
+		snapshotName := ada.CleanSnapshotName
+		if decision.SnapshotName != "" {
+			snapshotName = decision.SnapshotName
+		}
+		if err := inst.LoadSnapshot(snapshotName); err != nil {
+			restoreTime := time.Since(start)
+			if mgr.adaController != nil {
+				mgr.adaController.CompleteAction(inst.Index(), decision, restoreTime, false)
+			}
+			mgr.recordSnapshotRestoreTime(inst.Index(), restoreTime)
+			log.Logf(1, "VM %v: failed to restore snapshot %q: %v", inst.Index(), snapshotName, err)
+			return
+		}
+		softResets++
+		restoreTime := time.Since(start)
+		if mgr.adaController != nil {
+			mgr.adaController.CompleteAction(inst.Index(), decision, restoreTime, true)
+		}
+		mgr.recordSnapshotRestore(inst.Index(), restoreTime)
+		log.Logf(0, "VM %v: restored snapshot %q in %v", inst.Index(), snapshotName, restoreTime)
+	}
+}
+
+type snapshotPromoter interface {
+	SaveSnapshot(name string) error
+	DeleteSnapshot(name string) error
+}
+
+func promoteSnapshot(store snapshotPromoter, name, evict string) (time.Duration, error) {
+	start := time.Now()
+	if err := store.SaveSnapshot(name); err != nil {
+		return time.Since(start), fmt.Errorf("save new snapshot: %w", err)
+	}
+	if evict == "" {
+		return time.Since(start), nil
+	}
+	if err := store.DeleteSnapshot(evict); err != nil {
+		return time.Since(start), fmt.Errorf("failed to delete evicted snapshot %q: %w", evict, err)
+	}
+	return time.Since(start), nil
+}
+
+func (mgr *Manager) finishFuzzerRun(serv rpcserver.Server, inst *vm.Instance, reps []*report.Report,
+	vmInfo []byte, err error) error {
+	var extraExecs []report.ExecutorInfo
+	var rep *report.Report
+	if len(reps) != 0 {
+		rep = reps[0]
+		if rep != nil && rep.Executor != nil {
+			extraExecs = []report.ExecutorInfo{*rep.Executor}
+		}
+	}
+	var memoryDump string
+	if mgr.cfg.MemoryDump && rep != nil {
+		memoryDump = mgr.extractMemoryDump(inst, rep)
+	}
+	lastExec, machineInfo := serv.ShutdownInstance(inst.Index(), rep != nil, extraExecs...)
+	if mgr.adaController != nil {
+		for _, crashReport := range reps {
+			mgr.adaController.RecordCrash(inst.Index(), crashReport.Title, ada.UsefulAdaCrash(crashReport))
+		}
+	}
+	if rep != nil {
+		rpcserver.PrependExecuting(rep, lastExec)
+		if len(vmInfo) != 0 {
+			machineInfo = append(append(vmInfo, '\n'), machineInfo...)
+		}
+		rep.MachineInfo = machineInfo
+		mgr.crashes <- &manager.Crash{
+			InstanceIndex: inst.Index(),
+			Report:        rep,
+			TailReports:   reps[1:],
+			MemoryDump:    memoryDump,
+		}
+	}
+	if err != nil {
+		log.Logf(1, "VM %v: failed with error: %v", inst.Index(), err)
+	}
+	return err
+}
+
+func (mgr *Manager) runInstanceInner(ctx context.Context, inst *vm.Instance, opts ...func(*vm.RunOptions),
+) ([]*report.Report, []byte, error) {
+	fwdAddr, executorBin, err := mgr.prepareInstanceForFuzzing(inst)
+	if err != nil {
+		return nil, nil, err
+	}
+	return mgr.runInstanceWithExecutor(ctx, inst, fwdAddr, executorBin, opts...)
+}
+
+// prepareInstanceForFuzzing prepares fuzzing instance, returns fwdAddr, executor binary path,
+// and error messages
+func (mgr *Manager) prepareInstanceForFuzzing(inst *vm.Instance) (string, string, error) {
+	if mgr.rpcServ == nil {
+		return "", "", fmt.Errorf("crash snapshot requires RPC server")
+	}
+	fwdAddr, err := inst.Forward(mgr.rpcServ.Port())
+	if err != nil {
+		return "", "", fmt.Errorf("failed to setup port forwarding: %w", err)
+	}
+
+	// If ExecutorBin is provided, it means that syz-executor is already in the image,
+	// so no need to copy it.
+	executorBin := mgr.cfg.SysTarget.ExecutorBin
+	if executorBin == "" {
+		executorBin, err = inst.Copy(mgr.cfg.ExecutorBin)
+		if err != nil {
+			return "", "", fmt.Errorf("failed to copy binary: %w", err)
+		}
+	}
+	return fwdAddr, executorBin, nil
+}
+
+func (mgr *Manager) runInstanceWithExecutor(ctx context.Context, inst *vm.Instance, fwdAddr, executorBin string,
+	opts ...func(*vm.RunOptions)) ([]*report.Report, []byte, error) {
+	return mgr.runInstanceWithExecutorFor(ctx, mgr.cfg.Timeouts.VMRunningTime, inst, fwdAddr, executorBin, opts...)
+}
+
+func (mgr *Manager) runInstanceWithExecutorFor(ctx context.Context, runDuration time.Duration,
+	inst *vm.Instance, fwdAddr, executorBin string,
+	opts ...func(*vm.RunOptions)) ([]*report.Report, []byte, error) {
+	// Run the fuzzer binary.
+	start := time.Now()
+
+	host, port, err := net.SplitHostPort(fwdAddr)
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse manager's address")
+	}
+	cmd := fmt.Sprintf("%v runner %v %v %v", executorBin, inst.Index(), host, port)
+	ctxTimeout, cancel := context.WithTimeout(ctx, runDuration)
+	defer cancel()
+	_, reps, err := inst.Run(ctxTimeout, mgr.reporter, cmd, opts...)
+	if err != nil {
+		if errors.Is(err, vmimpl.ErrPreempted) {
+			log.Logf(0, "VM %v: preempted while executing", inst.Index())
+		} else {
+			err = fmt.Errorf("failed to run fuzzer: %w", err)
+		}
+	} else if len(reps) == 0 {
+		log.Logf(0, "VM %v: running for %v, restarting", inst.Index(), time.Since(start))
+	}
+	var vmInfo []byte
+	if len(reps) != 0 {
+		var infoErr error
+		vmInfo, infoErr = inst.Info()
+		if infoErr != nil {
+			vmInfo = []byte(fmt.Sprintf("error getting VM info: %v\n", infoErr))
+		}
+	}
+	return reps, vmInfo, err
+}
