+func (cfg *AdaptiveRestartConfig) complete(crashSnapshot bool) error {
+	if !cfg.Enabled {
+		return nil
+	}
+	if !crashSnapshot {
+		return fmt.Errorf("experimental.adaptive_restart requires experimental.crash_snapshot")
+	}
+	setDefault := func(value *int, def int) {
+		if *value == 0 {
+			*value = def
+		}
+	}
+	if cfg.DecisionMode == "" {
+		cfg.DecisionMode = "bandit"
+	}
+	if cfg.CrashRecovery == "" {
+		cfg.CrashRecovery = "clean"
+	}
+	setDefault(&cfg.MinMinutes, 15)
+	setDefault(&cfg.MaxMinutes, 60)
+	setDefault(&cfg.HardMaxMinutes, 240)
+	setDefault(&cfg.StallMinutes, 20)
+	setDefault(&cfg.EvaluationSeconds, 300)
+	setDefault(&cfg.MaxSoftResets, 8)
+	setDefault(&cfg.ThroughputDropPercent, 50)
+	setDefault(&cfg.UnhealthyThreshold, 3)
+	if cfg.SnapshotBankSize == nil {
+		value := 3
+		cfg.SnapshotBankSize = &value
+	}
+	setDefault(&cfg.StatePromotionThreshold, 8)
+	setDefault(&cfg.BanditExplorationPercent, 75)
+	setDefault(&cfg.LearningDiscountPercent, 98)
+
+	if cfg.DecisionMode != "heuristic" && cfg.DecisionMode != "bandit" {
+		return fmt.Errorf("experimental.adaptive_restart.decision_mode must be heuristic or bandit")
+	}
+	if cfg.CrashRecovery != "clean" && cfg.CrashRecovery != "lineage" {
+		return fmt.Errorf("experimental.adaptive_restart.crash_recovery must be clean or lineage")
+	}
+	if cfg.MinMinutes < 1 || cfg.MaxMinutes < cfg.MinMinutes {
+		return fmt.Errorf("experimental.adaptive_restart requires 1 <= min_minutes <= max_minutes")
+	}
+	if cfg.HardMaxMinutes < cfg.MaxMinutes {
+		return fmt.Errorf("experimental.adaptive_restart requires hard_max_minutes >= max_minutes")
+	}
+	if cfg.StallMinutes < 1 {
+		return fmt.Errorf("experimental.adaptive_restart.stall_minutes must be positive")
+	}
+	if cfg.EvaluationSeconds < 1 || cfg.EvaluationSeconds > cfg.MinMinutes*60 {
+		return fmt.Errorf("experimental.adaptive_restart.evaluation_seconds must be in [1, min_minutes * 60]")
+	}
+	if cfg.MaxSoftResets < 1 {
+		return fmt.Errorf("experimental.adaptive_restart.max_soft_resets must be positive")
+	}
+	if cfg.ThroughputDropPercent < 1 || cfg.ThroughputDropPercent > 99 {
+		return fmt.Errorf("experimental.adaptive_restart.throughput_drop_percent must be in [1, 99]")
+	}
+	if cfg.UnhealthyThreshold < 1 || cfg.UnhealthyThreshold > 100 {
+		return fmt.Errorf("experimental.adaptive_restart.unhealthy_threshold must be in [1, 100]")
+	}
+	if *cfg.SnapshotBankSize < 0 || *cfg.SnapshotBankSize > 16 {
+		return fmt.Errorf("experimental.adaptive_restart.snapshot_bank_size must be in [0, 16]")
+	}
+	if cfg.StatePromotionThreshold < 1 {
+		return fmt.Errorf("experimental.adaptive_restart.state_promotion_threshold must be positive")
+	}
+	if cfg.BanditExplorationPercent < 1 || cfg.BanditExplorationPercent > 1000 {
+		return fmt.Errorf("experimental.adaptive_restart.bandit_exploration_percent must be in [1, 1000]")
+	}
+	if cfg.LearningDiscountPercent < 50 || cfg.LearningDiscountPercent > 100 {
+		return fmt.Errorf("experimental.adaptive_restart.learning_discount_percent must be in [50, 100]")
+	}
+	if cfg.MaxConcurrentActions < 0 {
+		return fmt.Errorf("experimental.adaptive_restart.max_concurrent_actions cannot be negative")
+	}
+	return nil
+}
