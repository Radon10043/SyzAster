+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package tsc
+
+import "testing"
+
+func TestParseCPUID(t *testing.T) {
+	tests := []struct {
+		name    string
+		output  string
+		want    uint64
+		wantErr bool
+	}{
+		{
+			name: "intel",
+			output: `CPU:
+   Time Stamp Counter/Core Crystal Clock Information (0x15):
+      TSC/clock ratio = 182/2
+      nominal core crystal clock = 38400000 Hz`,
+			want: 3494400000,
+		},
+		{
+			// AMD does not populate leaf 0x15: zeros must be rejected so the
+			// caller falls back to calibration instead of dividing by zero.
+			name: "amd_zeros",
+			output: `CPU:
+   Time Stamp Counter/Core Crystal Clock Information (0x15):
+      TSC/clock ratio = 0/0
+      nominal core crystal clock = 0 Hz`,
+			wantErr: true,
+		},
+		{
+			name:    "unparsable",
+			output:  "CPU:\n   no such leaf",
+			wantErr: true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := parseCPUID(tc.output)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("parseCPUID() error = %v, wantErr = %v", err, tc.wantErr)
+			}
+			if err == nil && got != tc.want {
+				t.Fatalf("parseCPUID() = %d, want %d", got, tc.want)
+			}
+		})
+	}
+}
