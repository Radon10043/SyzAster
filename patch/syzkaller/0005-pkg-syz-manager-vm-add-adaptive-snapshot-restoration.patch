+// VMFeedback reports fuzzing outcomes attributed to the VM that discovered them.
+// Consumers must tolerate concurrent calls from fuzzing and triage goroutines.
+type VMFeedback struct {
+	VM           int
+	Executions   uint64
+	NewSignal    uint64
+	StableSignal uint64
+	NewInputs    uint64
+	Hangs        uint64
+	Failures     uint64
+	Restarts     uint64
+	StateDigest  uint64
+	StateEvents  uint64
+}
+
+func makeVMFeedback(req *queue.Request, res *queue.Result, triage map[int]*triageCall) (VMFeedback, bool) {
+	if !res.ExecutorValid {
+		return VMFeedback{}, false
+	}
+	feedback := VMFeedback{
+		VM:          res.Executor.VM,
+		Executions:  1,
+		StateDigest: stateDigest(req, res),
+		StateEvents: 1,
+	}
+	for _, info := range triage {
+		feedback.NewSignal += uint64(info.newSignal.Len())
+	}
+	switch res.Status {
+	case queue.Hanged:
+		feedback.Hangs = 1
+	case queue.ExecFailure:
+		feedback.Failures = 1
+	}
+	if res.Info != nil && res.Info.Freshness == 0 {
+		feedback.Restarts = 1
+	}
+	return feedback, true
+}
+
+// stateDigest is a low-overhead behavioral-state proxy. It intentionally uses
+// stable execution properties rather than process-local or monotonically
+// changing values so repeated behavior maps to the same state.
+func stateDigest(req *queue.Request, res *queue.Result) uint64 {
+	const (
+		offset = uint64(1469598103934665603)
+		prime  = uint64(1099511628211)
+	)
+	hash := offset
+	add := func(value uint64) {
+		hash ^= value
+		hash *= prime
+	}
+	addSignal := func(values []uint64) {
+		var xor, sum uint64
+		for _, value := range values {
+			value ^= value >> 30
+			value *= 0xbf58476d1ce4e5b9
+			value ^= value >> 27
+			value *= 0x94d049bb133111eb
+			value ^= value >> 31
+			xor ^= value
+			sum += value
+		}
+		add(uint64(len(values)))
+		add(xor)
+		add(sum)
+	}
+	add(uint64(res.Status))
+	if req.Prog != nil {
+		for index, call := range req.Prog.Calls {
+			add(uint64(call.Meta.ID))
+			if res.Info != nil && index < len(res.Info.Calls) && res.Info.Calls[index] != nil {
+				info := res.Info.Calls[index]
+				add(uint64(uint32(info.Error)))
+				addSignal(info.Signal)
+			}
+		}
+	}
+	if res.Info != nil && res.Info.Extra != nil {
+		addSignal(res.Info.Extra.Signal)
+	}
+	return hash
+}
