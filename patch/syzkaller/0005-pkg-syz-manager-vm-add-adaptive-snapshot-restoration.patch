+	controller.ForcedHardReset(0)
+	controller.RegisterCleanSnapshot(0, time.Second)
+	assert.True(t, controller.states[0].pending.attempted)
+	assert.Equal(t, time.Second, controller.states[0].pending.cost)
+}
