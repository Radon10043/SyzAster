+func TestAdaptiveRestartAfterLease(t *testing.T) {
+	controller := &Controller{
+		policy: RestartPolicy{
+			hardMax:              time.Hour,
+			maxSoftResets:        3,
+			maxConcurrentActions: 1,
+		},
+		feedback: make([]Feedback, 1),
+		states:   []*VMState{{}},
+	}
+	vmStarted := time.Now()
+	assert.Equal(t, RestartContinue, controller.AfterLease(0, vmStarted, 2).Action)
+	decision := controller.AfterLease(0, vmStarted, 3)
+	assert.Equal(t, RestartHard, decision.Action)
+	assert.Equal(t, RestartReasonTooManyRestores, decision.Reason)
+	assert.True(t, controller.states[0].actionInFlight)
+	assert.NotNil(t, controller.states[0].pending)
+	assert.Equal(t, RestartHard, controller.states[0].pending.action)
+	assert.False(t, controller.states[0].pending.learn)
+	assert.Equal(t, 1, controller.inFlight)
+}
+
+func TestAdaptiveRestartBoundaryConcurrencyLimit(t *testing.T) {
+	controller := &Controller{
+		policy: RestartPolicy{
+			hardMax:              time.Hour,
+			maxSoftResets:        3,
+			maxConcurrentActions: 1,
+		},
+		states:   []*VMState{{}, {}},
+		inFlight: 1,
+	}
+	decision := controller.AfterLease(1, time.Now(), 3)
+	assert.Equal(t, RestartContinue, decision.Action)
+	assert.Equal(t, RestartReasonActionLimit, decision.Reason)
+	assert.False(t, controller.states[1].actionInFlight)
+	assert.Equal(t, 1, controller.inFlight)
+}
