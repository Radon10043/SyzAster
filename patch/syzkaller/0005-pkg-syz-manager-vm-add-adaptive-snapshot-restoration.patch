+func TestLineageFollowsCheckpointsAndRestores(t *testing.T) {
+	controller := &Controller{
+		policy:   RestartPolicy{lineageCrashRecovery: true},
+		feedback: make([]Feedback, 1),
+		states: []*VMState{{
+			bank: snapshotBank{clean: Snapshot{name: CleanSnapshotName}},
+		}},
+	}
+	state := controller.states[0]
+	checkpoint := func(name string) {
+		controller.CompleteAction(0, RestartDecision{Action: RestartCheckpoint, SnapshotName: name}, 0, true)
+	}
+	restore := func(name string) {
+		controller.CompleteAction(0, RestartDecision{Action: RestartSoft, SnapshotName: name}, 0, true)
+	}
+
+	// The live state keeps running after a checkpoint, so it descends from it.
+	checkpoint("a")
+	assert.Equal(t, []string{"a"}, state.lineage)
+	assert.Empty(t, state.bank.find("a").ancestors)
+	checkpoint("b")
+	assert.Equal(t, []string{"a", "b"}, state.lineage)
+	assert.Equal(t, []string{"a"}, state.bank.find("b").ancestors)
+
+	// Restoring an older snapshot drops the later one from the lineage.
+	restore("a")
+	assert.Equal(t, []string{"a"}, state.lineage)
+	checkpoint("c")
+	assert.Equal(t, []string{"a", "c"}, state.lineage)
+	assert.Equal(t, []string{"a"}, state.bank.find("b").ancestors)
+
+	// "b" shares only the prefix "a" with the crashed state and stays eligible.
+	state.bank.find("b").value = 1
+	assert.Equal(t, "b", controller.RecoveryDecision(0, true).SnapshotName)
+	restore("b")
+	assert.Equal(t, []string{"a", "b"}, state.lineage)
+
+	restore(CleanSnapshotName)
+	assert.Empty(t, state.lineage)
+
+	// A checkpoint failure leaves the lineage untouched.
+	controller.CompleteAction(0, RestartDecision{Action: RestartCheckpoint, SnapshotName: "d"}, 0, false)
+	assert.Empty(t, state.lineage)
+
+	checkpoint("e")
+	controller.RegisterCleanSnapshot(0, 0)
+	assert.Empty(t, state.lineage)
+	assert.Empty(t, state.bank.entries)
+}
