+
+package adaptive
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"math/rand"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/fuzzer"
+	"github.com/google/syzkaller/pkg/mgrconfig"
+	"github.com/google/syzkaller/pkg/stat"
+)
+
+type RestartAct int
+
+// CleanSnapshotName is the base snapshot saved right after VM boot. It is
+// always a valid crash-recovery target.
+const CleanSnapshotName = "clean"
+
+const (
+	RestartContinue RestartAct = iota
+	RestartCheckpoint
+	RestartSoft
+	RestartHard
+	RestartActionCount
+)
+
+type RestartReason string
+
+const (
+	RestartReasonStalled         RestartReason = "stalled"
+	RestartReasonThroughput      RestartReason = "throughput"
+	RestartReasonUnhealthy       RestartReason = "unhealthy"
+	RestartReasonLeaseLimit      RestartReason = "lease-limit"
+	RestartReasonVMLifetime      RestartReason = "vm-lifetime"
+	RestartReasonTooManyRestores RestartReason = "too-many-restores"
+	RestartReasonOnlinePolicy    RestartReason = "online-policy"
+	RestartReasonStatePromotion  RestartReason = "state-promotion"
+	RestartReasonActionLimit     RestartReason = "action-limit"
+	RestartReasonCrashRecovery   RestartReason = "crash-recovery"
+	RestartReasonRunEnded        RestartReason = "run-ended"
+)
+
+type RestartDecision struct {
+	Action           RestartAct
+	Reason           RestartReason
+	LeaseAge         time.Duration
+	VMAge            time.Duration
+	StagnantFor      time.Duration
+	Execs            uint64
+	NewSignal        uint64
+	StableSignal     uint64
+	NewInputs        uint64
+	Hangs            uint64
+	Failures         uint64
+	Restarts         uint64
+	Crashes          uint64
+	UniqueCrashes    uint64
+	StateNovelty     uint64
+	StateEvents      uint64
+	StateNoveltyRate float64
+	StateValue       float64
+	StateAge         time.Duration
+	StateDigest      uint64
+	SoftResets       int
+	SnapshotName     string
+	DeleteSnapshot   string
+
+	fingerprint  stateFingerprint
+	noveltyScore uint64
+}
+
+// String returns the decision and its observation context in log-friendly form.
+func (dec RestartDecision) String() string {
+	return fmt.Sprintf("action=%v reason=%v lease_age=%v vm_age=%v stagnant=%v "+
+		"execs=%v new_signal=%v stable_signal=%v new_inputs=%v hangs=%v failures=%v restarts=%v "+
+		"crashes=%v unique_crashes=%v state_novelty=%v state_events=%v state_novelty_rate=%.3f "+
+		"state_value=%.3f state_age=%v "+
+		"state_digest=%x soft_resets=%v snapshot=%q",
+		dec.Action, dec.Reason, dec.LeaseAge, dec.VMAge,
+		dec.StagnantFor, dec.Execs, dec.NewSignal, dec.StableSignal,
+		dec.NewInputs, dec.Hangs, dec.Failures, dec.Restarts, dec.Crashes,
+		dec.UniqueCrashes, dec.StateNovelty, dec.StateEvents, dec.StateNoveltyRate,
+		dec.StateValue, dec.StateAge, dec.StateDigest, dec.SoftResets,
+		dec.SnapshotName)
+}
+
+// String returns the human-readable name of a restart action.
+func (act RestartAct) String() string {
+	switch act {
+	case RestartContinue:
+		return "continue"
+	case RestartCheckpoint:
+		return "checkpoint"
+	case RestartSoft:
+		return "snapshot-restore"
+	case RestartHard:
+		return "hard-reset"
+	default:
+		return "unknown"
+	}
+}
+
+type RestartPolicy struct {
+	decisionMode            string
+	minLease                time.Duration
+	maxLease                time.Duration
+	hardMax                 time.Duration
+	stall                   time.Duration
+	evaluation              time.Duration
+	maxSoftResets           int
+	throughputDropPct       uint64
+	unhealthy               uint64
+	snapshotBankSize        int
+	statePromotionThreshold uint64
+	maxConcurrentActions    int
+	lineageCrashRecovery    bool
+}
+
+// makeAdaptiveRestartPolicy converts manager configuration into runtime policy values.
+func makeAdaptiveRestartPolicy(cfg mgrconfig.AdaptiveRestartConfig, vmCount int) RestartPolicy {
+	maxConcurrent := cfg.MaxConcurrentActions
+	if maxConcurrent == 0 {
+		maxConcurrent = max(1, vmCount/4)
+	}
+	snapshotBankSize := 0
+	if cfg.SnapshotBankSize != nil {
+		snapshotBankSize = *cfg.SnapshotBankSize
+	}
+	return RestartPolicy{
+		decisionMode:            cfg.DecisionMode,
+		minLease:                time.Duration(cfg.MinMinutes) * time.Minute,
+		maxLease:                time.Duration(cfg.MaxMinutes) * time.Minute,
+		hardMax:                 time.Duration(cfg.HardMaxMinutes) * time.Minute,
+		stall:                   time.Duration(cfg.StallMinutes) * time.Minute,
+		evaluation:              time.Duration(cfg.EvaluationSeconds) * time.Second,
+		maxSoftResets:           cfg.MaxSoftResets,
+		throughputDropPct:       uint64(cfg.ThroughputDropPercent),
+		unhealthy:               uint64(cfg.UnhealthyThreshold),
+		snapshotBankSize:        snapshotBankSize,
+		statePromotionThreshold: uint64(cfg.StatePromotionThreshold),
+		maxConcurrentActions:    maxConcurrent,
+		lineageCrashRecovery:    cfg.CrashRecovery == "lineage",
+	}
+}
+
+type Feedback struct {
+	execs         atomic.Uint64
+	newSignal     atomic.Uint64
+	stableSignal  atomic.Uint64
+	newInputs     atomic.Uint64
+	hangs         atomic.Uint64
+	failures      atomic.Uint64
+	restarts      atomic.Uint64
+	crashes       atomic.Uint64
+	uniqueCrashes atomic.Uint64
+	lastProgress  atomic.Int64
+	state         stateSketch
+}
+
+type feedbackSnapshot struct {
+	execs         uint64
+	newSignal     uint64
+	stableSignal  uint64
+	newInputs     uint64
+	hangs         uint64
+	failures      uint64
+	restarts      uint64
+	crashes       uint64
+	uniqueCrashes uint64
+	stateNovelty  uint64
+	stateEvents   uint64
+}
+
+// delta returns the feedback accumulated since a previous cumulative snapshot.
+func (fs feedbackSnapshot) delta(prev feedbackSnapshot) feedbackSnapshot {
+	return feedbackSnapshot{
+		execs:         fs.execs - prev.execs,
+		newSignal:     fs.newSignal - prev.newSignal,
+		stableSignal:  fs.stableSignal - prev.stableSignal,
+		newInputs:     fs.newInputs - prev.newInputs,
+		hangs:         fs.hangs - prev.hangs,
+		failures:      fs.failures - prev.failures,
+		restarts:      fs.restarts - prev.restarts,
+		crashes:       fs.crashes - prev.crashes,
+		uniqueCrashes: fs.uniqueCrashes - prev.uniqueCrashes,
+		stateNovelty:  fs.stateNovelty - prev.stateNovelty,
+		stateEvents:   fs.stateEvents - prev.stateEvents,
+	}
+}
+
+type VMState struct {
+	value       float64
+	lastNovelty uint64
+	pending     *learningSample
+	bank        snapshotBank
+	// Intermediate snapshots whose saved state the live kernel state extends.
+	lineage        []string
+	actionInFlight bool
+	stateStarted   time.Time
+}
+
+// Controller owns the adaptive restart policy for a VM pool.
+type Controller struct {
+	policy   RestartPolicy
+	feedback []Feedback
+	states   []*VMState
+	random   []random
+	learner  *linearUCB
+
+	mu          sync.Mutex
+	inFlight    int
+	seenCrashes map[string]struct{}
+
+	statSoftReset           *stat.Val
+	statHardReset           *stat.Val
+	statCheckpoint          *stat.Val
+	statOnlineDecision      *stat.Val
+	statOnlineEval          *stat.Val
+	statActionDeferred      *stat.Val
+	statModelUpdate         *stat.Val
+	statActionFailure       *stat.Val
+	statCheckpointCredit    *stat.Val
+	statIntermediateRestore *stat.Val
+	statSnapshotEviction    *stat.Val
+	statReward              *stat.Val
+	statStalled             *stat.Val
+	statThroughput          *stat.Val
+	statUnhealthy           *stat.Val
+	statLeaseLimit          *stat.Val
+	statVMLifetime          *stat.Val
+	statRestoreLimit        *stat.Val
+	statCrashRecovery       *stat.Val
+	statCrashIntermediate   *stat.Val
+	statRunEnded            *stat.Val
+}
+
+type random struct {
+	mu  sync.Mutex
+	rnd *rand.Rand
+}
+
+// NewController creates an adaptive restart controller for a VM pool.
+func NewController(cfg mgrconfig.AdaptiveRestartConfig, vmCount int) *Controller {
+	seed := time.Now().UnixNano()
+	random := make([]random, vmCount)
+	states := make([]*VMState, vmCount)
+	for vm := range random {
+		random[vm].rnd = rand.New(rand.NewSource(seed + int64(vm+1)*1_000_003))
+		states[vm] = &VMState{stateStarted: time.Now()}
+	}
+	newResetStat := func(name, description string) *stat.Val {
+		return stat.New(name, description, stat.Rate{}, stat.Graph("adaptive resets"))
+	}
+	controller := &Controller{
+		policy:             makeAdaptiveRestartPolicy(cfg, vmCount),
+		feedback:           make([]Feedback, vmCount),
+		states:             states,
+		random:             random,
+		learner:            newLinearUCB(float64(cfg.BanditExplorationPercent)/100, float64(cfg.LearningDiscountPercent)/100),
+		seenCrashes:        make(map[string]struct{}),
+		statSoftReset:      newResetStat("adaptive soft resets", "Snapshot restores requested by the adaptive policy"),
+		statHardReset:      newResetStat("adaptive hard resets", "Full VM reboots requested by the adaptive policy"),
+		statCheckpoint:     newResetStat("adaptive checkpoints", "Intermediate state snapshots promoted by the adaptive policy"),
+		statOnlineDecision: newResetStat("adaptive online decisions", "Actions selected by the online policy"),
+		statOnlineEval:     newResetStat("adaptive evaluations", "Decision windows evaluated by the adaptive controller"),
+		statActionDeferred: newResetStat("adaptive action deferred", "Adaptive actions deferred by the concurrency limit"),
+		statModelUpdate:    newResetStat("adaptive model updates", "Rewards applied to the online decision model"),
+		statActionFailure: newResetStat("adaptive action failures",
+			"Failed snapshot actions or unexpected VM replacements"),
+		statCheckpointCredit: newResetStat("adaptive checkpoint credits",
+			"Delayed rewards attributed to checkpoint creation after intermediate snapshot reuse"),
+		statIntermediateRestore: newResetStat("adaptive intermediate restores",
+			"Intermediate snapshot restores requested by the adaptive policy"),
+		statSnapshotEviction: newResetStat("adaptive snapshot evictions",
+			"Intermediate snapshots evicted from full per-VM banks"),
+		statReward: stat.New("adaptive reward", "Mean online-policy reward multiplied by 100",
+			stat.Distribution{}, stat.NoGraph),
+		statStalled:      newResetStat("adaptive reset stalled", "Adaptive resets caused by feedback stalls"),
+		statThroughput:   newResetStat("adaptive reset throughput", "Adaptive resets caused by throughput degradation"),
+		statUnhealthy:    newResetStat("adaptive reset unhealthy", "Adaptive resets caused by a high hang or failure rate"),
+		statLeaseLimit:   newResetStat("adaptive reset lease limit", "Adaptive resets caused by lease limits"),
+		statVMLifetime:   newResetStat("adaptive reset vm lifetime", "Adaptive resets caused by VM lifetime limits"),
+		statRestoreLimit: newResetStat("adaptive reset restore limit", "Adaptive resets caused by snapshot restore limits"),
+		statCrashRecovery: newResetStat("adaptive reset crash recovery",
+			"Mandatory snapshot restores after a kernel crash"),
+		statCrashIntermediate: newResetStat("adaptive crash recovery intermediate",
+			"Crash recoveries that restored an intermediate snapshot outside the crashed state's lineage"),
+		statRunEnded: newResetStat("adaptive reset run ended",
+			"Mandatory snapshot restores after a fuzzing run ended without a policy action"),
+	}
+	stat.New("adaptive snapshot bank entries", "Number of retained intermediate state snapshots",
+		stat.NoGraph, func() int {
+			controller.mu.Lock()
+			defer controller.mu.Unlock()
+			count := 0
+			for _, state := range controller.states {
+				count += len(state.bank.entries)
+			}
+			return count
+		})
+	stat.New("adaptive state novelty", "Total recent behavioral-state cache misses",
+		stat.NoGraph, func() int {
+			var total uint64
+			for index := range controller.feedback {
+				total += controller.feedback[index].state.novelty.Load()
+			}
+			return int(total)
+		})
+	stat.New("adaptive state events", "Total behavioral-state digests observed",
+		stat.NoGraph, func() int {
+			var total uint64
+			for index := range controller.feedback {
+				total += controller.feedback[index].state.events.Load()
+			}
+			return int(total)
+		})
+	stat.New("adaptive mean state value", "Mean current VM state value multiplied by 100",
+		stat.NoGraph, func() int {
+			controller.mu.Lock()
+			defer controller.mu.Unlock()
+			if len(controller.states) == 0 {
+				return 0
+			}
+			var total float64
+			for _, state := range controller.states {
+				total += state.value
+			}
+			return int(total * 100 / float64(len(controller.states)))
+		})
+	return controller
+}
+
+// Record adds VM-local fuzzing feedback to the controller's cumulative counters.
+func (c *Controller) Record(feedback fuzzer.VMFeedback) {
+	if feedback.VM < 0 || feedback.VM >= len(c.feedback) {
+		return
+	}
+	counter := &c.feedback[feedback.VM]
+	counter.execs.Add(feedback.Executions)
+	counter.newSignal.Add(feedback.NewSignal)
+	counter.stableSignal.Add(feedback.StableSignal)
+	counter.newInputs.Add(feedback.NewInputs)
+	counter.hangs.Add(feedback.Hangs)
+	counter.failures.Add(feedback.Failures)
+	counter.restarts.Add(feedback.Restarts)
+	counter.state.record(feedback.StateDigest, feedback.StateEvents)
+	// Asynchronous triage feedback can arrive after another lease has begun.
+	if feedback.NewSignal != 0 || feedback.StableSignal != 0 || feedback.NewInputs != 0 {
+		counter.lastProgress.Store(time.Now().UnixNano())
+	}
+}
+
+// RecordCrash records a crash and marks its title as useful progress when it is
+// the first useful occurrence in the campaign.
+func (c *Controller) RecordCrash(vm int, title string, useful bool) {
+	if vm < 0 || vm >= len(c.feedback) {
+		return
+	}
+	c.feedback[vm].crashes.Add(1)
+	if title == "" || !useful {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if _, exists := c.seenCrashes[title]; !exists {
+		c.seenCrashes[title] = struct{}{}
+		c.feedback[vm].uniqueCrashes.Add(1)
+		c.feedback[vm].lastProgress.Store(time.Now().UnixNano())
+	}
+}
+
+// snapshot returns an atomic cumulative view of one VM's feedback counters.
+func (c *Controller) snapshot(vm int) feedbackSnapshot {
+	counter := &c.feedback[vm]
+	return feedbackSnapshot{
+		execs:         counter.execs.Load(),
+		newSignal:     counter.newSignal.Load(),
+		stableSignal:  counter.stableSignal.Load(),
+		newInputs:     counter.newInputs.Load(),
+		hangs:         counter.hangs.Load(),
+		failures:      counter.failures.Load(),
+		restarts:      counter.restarts.Load(),
+		crashes:       counter.crashes.Load(),
+		uniqueCrashes: counter.uniqueCrashes.Load(),
+		stateNovelty:  counter.state.novelty.Load(),
+		stateEvents:   counter.state.events.Load(),
+	}
+}
+
+// RegisterCleanSnapshot registers a usable VM and its clean snapshot, accounts
+// for boot cost, and resets the VM-local snapshot bank and state model.
+func (c *Controller) RegisterCleanSnapshot(vm int, bootCost time.Duration) {
+	if vm < 0 || vm >= len(c.states) {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state := c.states[vm]
+	if state.pending != nil && state.pending.action != RestartHard && !state.pending.attempted {
+		// The VM disappeared before the selected non-hard action was attempted.
+		// Treat the sample as censored instead of training the action as a
+		// failure caused by an unrelated infrastructure restart.
+		state.pending = nil
+	}
+	if state.pending != nil {
+		if state.pending.action != RestartHard && !state.pending.failed {
+			state.pending.failed = true
+			if c.statActionFailure != nil {
+				c.statActionFailure.Add(1)
+			}
+		}
+		state.pending.attempted = true
+		state.pending.cost += bootCost
+		// Feedback that arrived before the replacement VM became usable belongs
+		// to the preceding state, not to the rebooted state's outcome.
+		state.pending.baseline = c.snapshot(vm)
+		// A hard reset destroys every snapshot in the old per-VM bank. Keep the
+		// action sample for online learning, but never attribute its outcome to a
+		// newly created snapshot that happens to reuse the same name.
+		state.pending.snapshot = ""
+	}
+	c.completeInFlightLocked(state)
+	state.bank.reset(CleanSnapshotName, time.Now())
+	state.lineage = nil
+	state.value = 0
+	state.lastNovelty = 0
+	state.stateStarted = time.Now()
+	c.feedback[vm].state.restore(stateFingerprint{})
+}
+
+// CompleteAction records an attempted action's cost and result, then applies
+// successful checkpoint or restore metadata to the VM state.
+func (c *Controller) CompleteAction(vm int, dec RestartDecision, cost time.Duration, succ bool) {
+	if vm < 0 || vm >= len(c.states) {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state := c.states[vm]
+	var promotionFeatures features
+	promotionLearn := false
+	if state.pending != nil && state.pending.action == RestartCheckpoint {
+		promotionFeatures = state.pending.features
+		promotionLearn = state.pending.learn
+	}
+	if !succ && c.statActionFailure != nil {
+		c.statActionFailure.Add(1)
+	}
+	if state.pending != nil {
+		state.pending.attempted = true
+		state.pending.cost += cost
+		if !succ {
+			state.pending.failed = true
+		}
+		// Exclude asynchronous feedback produced before the selected action was
+		// actually applied. The next observation now measures the post-action
+		// state while elapsed time and cost still capture its opportunity cost.
+		state.pending.baseline = c.snapshot(vm)
+	}
+	c.completeInFlightLocked(state)
+	if !succ {
+		return
+	}
+	switch dec.Action {
+	case RestartCheckpoint:
+		fingerprint := dec.fingerprint
+		if vm < len(c.feedback) {
+			// Feedback can arrive while the runner is stopping and the QEMU
+			// snapshot is being saved. Record the fingerprint closest to the
+			// actual saved state rather than the earlier decision-time state.
+			fingerprint = c.feedback[vm].state.snapshot()
+		}
+		state.bank.remove(dec.DeleteSnapshot)
+		if dec.DeleteSnapshot != "" && c.statSnapshotEviction != nil {
+			c.statSnapshotEviction.Add(1)
+		}
+		state.bank.append(Snapshot{
+			name:              dec.SnapshotName,
+			created:           time.Now(),
+			stateAge:          dec.StateAge,
+			fingerprint:       fingerprint,
+			value:             dec.StateValue,
+			novelty:           dec.noveltyScore,
+			promotionFeatures: promotionFeatures,
+			promotionLearn:    promotionLearn,
+			ancestors:         slices.Clone(state.lineage),
+		})
+		// The VM keeps running the checkpointed state, so everything it does
+		// from now on extends the new snapshot.
+		state.lineage = append(state.lineage, dec.SnapshotName)
+	case RestartSoft:
+		snapshot := state.bank.find(dec.SnapshotName)
+		if snapshot != nil {
+			snapshot.uses++
+			state.value = snapshot.value
+			state.lastNovelty = snapshot.novelty
+			if snapshot.name == state.bank.clean.name {
+				// Restoring clean creates a fresh kernel state. Reusing the
+				// clean snapshot's creation time would make the reset state look
+				// increasingly old to the state-age model.
+				state.stateStarted = time.Now()
+			} else {
+				// Resume the active state lifetime saved with the snapshot. Time
+				// spent frozen in the bank must not make kernel state appear
+				// deeper or longer-lived.
+				state.stateStarted = time.Now().Add(-snapshot.stateAge)
+			}
+			state.lineage = snapshot.lineage()
+			c.feedback[vm].state.restore(snapshot.fingerprint)
+		}
+	}
+}
+
+// ForcedHardReset prepares the controller for a VM replacement while preserving
+// an attributable hard-reset sample until the replacement becomes usable.
+func (c *Controller) ForcedHardReset(vm int) {
+	if vm < 0 || vm >= len(c.states) {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state := c.states[vm]
+	if state.pending != nil {
+		switch {
+		case state.pending.action == RestartHard:
+			// Keep a selected hard-reset sample alive until the replacement VM
+			// registers its clean snapshot. Otherwise the online learner never
+			// observes reboot cost or the resulting fresh state.
+			state.pending.attempted = true
+		case state.pending.attempted:
+			c.finishLearningSampleLocked(state, c.snapshot(vm), time.Now())
+		default:
+			state.pending = nil
+		}
+	}
+	if !state.actionInFlight {
+		state.actionInFlight = true
+		c.inFlight++
+	}
+}
+
+// RecoveryDecision closes the preceding observation and returns the mandatory
+// snapshot restore used after a crash or otherwise ended fuzzing run. A crashed
+// state is never restored into a snapshot it descends from: the corruption may
+// predate the crash report and already be present in those snapshots.
+func (c *Controller) RecoveryDecision(vm int, crashed bool) RestartDecision {
+	if vm < 0 || vm >= len(c.states) {
+		return RestartDecision{Action: RestartSoft, SnapshotName: CleanSnapshotName}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state := c.states[vm]
+	now := time.Now()
+	current := c.snapshot(vm)
+	// Close the previous action's observation before the mandatory recovery.
+	// The post-restore reward must describe the selected snapshot, not be mixed
+	// into the action that happened to precede the ended fuzzing run.
+	c.finishLearningSampleLocked(state, current, now)
+	fingerprint := c.feedback[vm].state.snapshot()
+	rnd := c.randomFloat(vm)
+	snapshot := state.bank.selectRandom(nil, rnd)
+	if crashed {
+		snapshot = &state.bank.clean
+		if c.policy.lineageCrashRecovery {
+			snapshot = state.bank.selectRandom(state.lineage, rnd)
+		}
+	}
+	dec := RestartDecision{
+		Action:           RestartSoft,
+		Reason:           RestartReasonRunEnded,
+		StateValue:       state.value,
+		StateDigest:      fingerprint.digest(),
+		SnapshotName:     snapshot.name,
+		fingerprint:      fingerprint,
+		StateNoveltyRate: float64(state.lastNovelty),
+		noveltyScore:     state.lastNovelty,
+	}
+	if !state.actionInFlight {
+		state.actionInFlight = true
+		c.inFlight++
+	}
+	if crashed {
+		dec.Reason = RestartReasonCrashRecovery
+	}
+	state.pending = &learningSample{
+		action:   RestartSoft,
+		baseline: current,
+		started:  now,
+		snapshot: snapshot.name,
+	}
+	return dec
+}
+
+// completeInFlightLocked releases an action reservation. The caller must hold c.mu.
+func (c *Controller) completeInFlightLocked(state *VMState) {
+	if state.actionInFlight {
+		state.actionInFlight = false
+		c.inFlight--
+	}
+}
+
+// peerLastProgress returns the latest useful-progress time reported by another VM.
+func (c *Controller) peerLastProgress(vm int) time.Time {
+	var latest int64
+	for index := range c.feedback {
+		if index == vm {
+			continue
+		}
+		latest = max(latest, c.feedback[index].lastProgress.Load())
+	}
+	return time.Unix(0, latest)
+}
+
+// leaseLimit returns a randomized lease limit bounded by the configured minimum.
+func (c *Controller) leaseLimit(vm int) time.Duration {
+	jitter := 0.75 + c.randomFloat(vm)*0.25
+	return max(c.policy.minLease, time.Duration(float64(c.policy.maxLease)*jitter))
+}
+
+// HardMax returns the maximum duration for one VM lifetime.
+func (c *Controller) HardMax() time.Duration {
+	return c.policy.hardMax
+}
+
+// randomFloat returns the next concurrency-safe pseudo-random value for one VM.
+func (c *Controller) randomFloat(vm int) float64 {
+	if vm < 0 || vm >= len(c.random) {
+		return rand.Float64()
+	}
+	random := &c.random[vm]
+	random.mu.Lock()
+	defer random.mu.Unlock()
+	return random.rnd.Float64()
+}
+
+// StartLease starts monitoring one fuzzing lease and returns its context, stop
+// function, and channel for the first disruptive decision.
+func (c *Controller) StartLease(parent context.Context, vm int, vmStarted time.Time,
+	softResets int) (context.Context, func(), <-chan RestartDecision) {
+	ctx, cancel := context.WithCancel(parent)
+	decisions := make(chan RestartDecision, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		c.monitor(ctx, cancel, decisions, vm, vmStarted, softResets)
+	}()
+	stop := func() {
+		cancel()
+		<-done
+	}
+	return ctx, stop, decisions
+}
+
+// BeforeLease enforces VM-lifetime safety boundaries before starting a lease.
+func (c *Controller) BeforeLease(vm int, vmStarted time.Time, softResets int) RestartDecision {
+	return c.boundaryDecision(vm, vmStarted, softResets, false)
+}
+
+// AfterLease enforces VM-lifetime and restore-count safety boundaries after a lease.
+func (c *Controller) AfterLease(vm int, vmStarted time.Time, softResets int) RestartDecision {
+	return c.boundaryDecision(vm, vmStarted, softResets, true)
+}
+
+// boundaryDecision evaluates configured safety boundaries and reserves a
+// required hard reset when concurrency capacity permits.
+func (c *Controller) boundaryDecision(vm int, vmStarted time.Time, softResets int,
+	enforceRestoreLimit bool) RestartDecision {
+	now := time.Now()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	state := c.states[vm]
+	dec := RestartDecision{
+		VMAge:      now.Sub(vmStarted),
+		SoftResets: softResets,
+	}
+	if dec.VMAge >= c.policy.hardMax {
+		dec.Action = RestartHard
+		dec.Reason = RestartReasonVMLifetime
+	} else if enforceRestoreLimit && softResets >= c.policy.maxSoftResets {
+		dec.Action = RestartHard
+		dec.Reason = RestartReasonTooManyRestores
+	}
+	if c.reserveActionLocked(state, &dec) && dec.Action == RestartHard {
+		c.startBoundaryHardResetLocked(vm, state, dec, now)
+	}
+	return dec
+}
+
+// startBoundaryHardResetLocked starts accounting for a safety-mandated hard
+// reset without training the online policy. The caller must hold c.mu.
+func (c *Controller) startBoundaryHardResetLocked(vm int, state *VMState, dec RestartDecision, now time.Time) {
+	if state.pending != nil && state.pending.action == RestartHard {
+		return
+	}
+	current := c.snapshot(vm)
+	if state.pending != nil {
+		if state.pending.attempted {
+			c.finishLearningSampleLocked(state, current, now)
+		} else {
+			state.pending = nil
+		}
+	}
+	// Boundary resets are safety actions, so they are measured for action cost,
+	// snapshot quality and observability but do not train the online
+	// policy as if it selected the reset.
+	c.startLearningSampleLocked(state, dec, features{}, current, now)
+}
+
+// monitor evaluates periodic feedback windows until the lease is stopped or a
+// disruptive decision is emitted.
+func (c *Controller) monitor(ctx context.Context, cancel context.CancelFunc,
+	decisions chan<- RestartDecision, vm int, vmStarted time.Time, softResets int) {
+	leaseStarted := time.Now()
+	lastProgress := leaseStarted
+	previous := c.snapshot(vm)
+	leaseLimit := c.leaseLimit(vm)
+	var bestExecs uint64
+	lowThroughputWindows := 0
+	ticker := time.NewTicker(c.policy.evaluation)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-ticker.C:
+			current := c.snapshot(vm)
+			window := current.delta(previous)
+			previous = current
+			if window.newSignal != 0 {
+				lastProgress = now
+			} else if progress := c.feedback[vm].lastProgress.Load(); progress > lastProgress.UnixNano() {
+				lastProgress = time.Unix(0, progress)
+			}
+			if window.execs > bestExecs {
+				bestExecs = window.execs
+			}
+			keepPercent := uint64(100) - c.policy.throughputDropPct
+			if bestExecs != 0 && window.execs*100 < bestExecs*keepPercent {
+				lowThroughputWindows++
+			} else {
+				lowThroughputWindows = 0
+			}
+			dec := c.decide(vm, restartObservation{
+				now:                  now,
+				vmStarted:            vmStarted,
+				leaseStarted:         leaseStarted,
+				lastProgress:         lastProgress,
+				peerLastProgress:     c.peerLastProgress(vm),
+				leaseLimit:           leaseLimit,
+				softResets:           softResets,
+				lowThroughputWindows: lowThroughputWindows,
+				bestExecs:            bestExecs,
+				window:               window,
+			}, current)
+			if dec.Action == RestartContinue {
+				continue
+			}
+			decisions <- dec
+			cancel()
+			return
+		}
+	}
+}
+
+type restartObservation struct {
+	now                  time.Time
+	vmStarted            time.Time
+	leaseStarted         time.Time
+	lastProgress         time.Time
+	peerLastProgress     time.Time
+	leaseLimit           time.Duration
+	softResets           int
+	lowThroughputWindows int
+	bestExecs            uint64
+	window               feedbackSnapshot
+	random               float64
+	stateValue           float64
+	stateAge             time.Duration
+	fingerprint          stateFingerprint
+}
+
+// decide completes the prior learning sample, updates state value, and selects
+// the next action for an observation window.
+func (c *Controller) decide(vm int, obs restartObservation, current feedbackSnapshot) RestartDecision {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state := c.states[vm]
+	if c.statOnlineEval != nil {
+		c.statOnlineEval.Add(1)
+	}
+	c.finishLearningSampleLocked(state, current, obs.now)
+	state.lastNovelty = stateNoveltyScore(obs.window)
+	if state.stateStarted.IsZero() {
+		state.stateStarted = obs.vmStarted
+	}
+	state.value = 0.8*state.value + 0.2*instantStateValue(obs.window)
+	if obs.leaseLimit <= 0 || obs.leaseLimit > c.policy.maxLease {
+		// Enforce the configured state lease budget.
+		obs.leaseLimit = c.policy.maxLease
+	}
+	obs.stateValue = state.value
+	obs.stateAge = obs.now.Sub(state.stateStarted)
+	obs.fingerprint = c.feedback[vm].state.snapshot()
+	obs.random = c.randomFloat(vm)
+
+	dec := decisionFromObservation(obs)
+	switch {
+	case dec.VMAge >= c.policy.hardMax:
+		dec.Action, dec.Reason = RestartHard, RestartReasonVMLifetime
+	case dec.LeaseAge < c.policy.minLease:
+		dec.Action = RestartContinue
+	case obs.softResets >= c.policy.maxSoftResets:
+		// Let a just-restored state produce at least one useful observation
+		// window before enforcing the restore-count boundary.
+		dec.Action, dec.Reason = RestartHard, RestartReasonTooManyRestores
+	case unhealthyWindow(obs.window, c.policy.unhealthy):
+		dec.Action, dec.Reason = RestartSoft, RestartReasonUnhealthy
+	case c.policy.decisionMode == "heuristic":
+		dec = evaluateAdaptiveRestart(obs, c.policy)
+		if dec.Action == RestartContinue && c.canPromoteHeuristicLocked(vm, obs) {
+			dec.Action, dec.Reason = RestartCheckpoint, RestartReasonStatePromotion
+		}
+	default:
+		dec = c.onlineDecisionLocked(vm, obs)
+	}
+	c.prepareActionLocked(vm, &dec)
+	c.startLearningSampleLocked(state, dec, adaptiveFeaturesFor(obs), current, obs.now)
+	return dec
+}
+
+// instantStateValue estimates the current kernel state's utility from one feedback window.
+func instantStateValue(window feedbackSnapshot) float64 {
+	progress := 2*math.Log1p(float64(window.newSignal)) +
+		5*math.Log1p(float64(window.stableSignal)) +
+		8*float64(window.newInputs) +
+		1.5*math.Log1p(stateNoveltyRate(window)) +
+		25*float64(window.uniqueCrashes)
+	repeatedCrashes := repeatedCrashCount(window)
+	penalty := 3*float64(window.hangs+window.failures) + float64(repeatedCrashes)
+	return progress + math.Log1p(float64(window.execs))/10 - penalty
+}
+
+// unhealthyWindow reports whether hangs and failures reach the configured execution ratio.
+func unhealthyWindow(window feedbackSnapshot, thresholdPercent uint64) bool {
+	if window.execs == 0 {
+		return false
+	}
+	return (window.hangs+window.failures)*100 >= window.execs*thresholdPercent
+}
+
+// decisionFromObservation copies an observation into a decision context without selecting an action.
+func decisionFromObservation(obs restartObservation) RestartDecision {
+	return RestartDecision{
+		LeaseAge:         obs.now.Sub(obs.leaseStarted),
+		VMAge:            obs.now.Sub(obs.vmStarted),
+		StagnantFor:      obs.now.Sub(obs.lastProgress),
+		Execs:            obs.window.execs,
+		NewSignal:        obs.window.newSignal,
+		StableSignal:     obs.window.stableSignal,
+		NewInputs:        obs.window.newInputs,
+		Hangs:            obs.window.hangs,
+		Failures:         obs.window.failures,
+		Restarts:         obs.window.restarts,
+		Crashes:          obs.window.crashes,
+		UniqueCrashes:    obs.window.uniqueCrashes,
+		StateNovelty:     obs.window.stateNovelty,
+		StateEvents:      obs.window.stateEvents,
+		StateNoveltyRate: stateNoveltyRate(obs.window),
+		StateValue:       obs.stateValue,
+		StateAge:         obs.stateAge,
+		StateDigest:      obs.fingerprint.digest(),
+		SoftResets:       obs.softResets,
+		fingerprint:      obs.fingerprint,
+		noveltyScore:     stateNoveltyScore(obs.window),
+	}
+}
+
+// stateNoveltyScore returns the rounded number of novelty events per thousand state events.
+func stateNoveltyScore(window feedbackSnapshot) uint64 {
+	return uint64(math.Round(stateNoveltyRate(window)))
+}
+
+// onlineDecisionLocked builds the eligible action set and selects an action
+// with the online learner. The caller must hold c.mu.
+func (c *Controller) onlineDecisionLocked(vm int, obs restartObservation) RestartDecision {
+	dec := decisionFromObservation(obs)
+	actions := []RestartAct{RestartContinue, RestartSoft}
+	if c.canPromoteLocked(vm, obs) {
+		actions = append(actions, RestartCheckpoint)
+	}
+	if dec.VMAge >= c.policy.maxLease ||
+		obs.softResets >= max(1, c.policy.maxSoftResets/2) {
+		actions = append(actions, RestartHard)
+	}
+	dec.Action = c.learner.selectAction(adaptiveFeaturesFor(obs), actions, obs.random)
+	dec.Reason = RestartReasonOnlinePolicy
+	if dec.Action == RestartCheckpoint {
+		dec.Reason = RestartReasonStatePromotion
+	}
+	if c.statOnlineDecision != nil {
+		c.statOnlineDecision.Add(1)
+	}
+	return dec
+}
+
+// promotionCandidateLocked returns the VM's snapshot bank when the observed
+// state satisfies the basic duplicate-free promotion requirements. The caller
+// must hold c.mu.
+func (c *Controller) promotionCandidateLocked(vm int, obs restartObservation) (*snapshotBank, bool) {
+	if vm < 0 || vm >= len(c.states) ||
+		c.policy.snapshotBankSize <= 0 ||
+		obs.fingerprint.count() == 0 {
+		return nil, false
+	}
+	bank := &c.states[vm].bank
+	if bank.containsFingerprint(obs.fingerprint) {
+		return nil, false
+	}
+	return bank, true
+}
+
+// canPromoteHeuristicLocked reports whether the strict heuristic novelty
+// threshold permits promotion. The caller must hold c.mu.
+func (c *Controller) canPromoteHeuristicLocked(vm int, obs restartObservation) bool {
+	_, candidate := c.promotionCandidateLocked(vm, obs)
+	return candidate && obs.window.stateNovelty >= c.policy.statePromotionThreshold
+}
+
+// canPromoteLocked reports whether the online policy may consider checkpoint
+// promotion based on novelty or useful behavioral distance. The caller must hold c.mu.
+func (c *Controller) canPromoteLocked(vm int, obs restartObservation) bool {
+	bank, candidate := c.promotionCandidateLocked(vm, obs)
+	if !candidate {
+		return false
+	}
+	if obs.window.stateNovelty >= c.policy.statePromotionThreshold {
+		return true
+	}
+	// A campaign-local novelty cache eventually recognizes most recurring
+	// behavior. Keep the bank reachable after that point by admitting states
+	// that made useful progress and are behaviorally distinct from every
+	// retained intermediate snapshot. The learner still decides whether the
+	// checkpoint's measured cost is worthwhile.
+	return usefulStateProgress(obs.window) &&
+		bank.closestDistance(obs.fingerprint) >= statePromotionMinDistance
+}
+
+// usefulStateProgress reports whether a window produced useful fuzzing progress.
+func usefulStateProgress(window feedbackSnapshot) bool {
+	return window.newSignal != 0 || window.stableSignal != 0 ||
+		window.newInputs != 0 || window.uniqueCrashes != 0
+}
+
+// adaptiveFeaturesFor converts an observation into the normalized Linear-UCB context vector.
+func adaptiveFeaturesFor(obs restartObservation) features {
+	healthRate := 0.0
+	if obs.window.execs != 0 {
+		// A hang commonly causes an executor restart, so use the larger count
+		// rather than charging the same disruption twice.
+		disruptions := obs.window.failures + max(obs.window.hangs, obs.window.restarts)
+		healthRate = 1000 * float64(disruptions) / float64(obs.window.execs)
+	}
+	throughputRatio := 1.0
+	if obs.bestExecs != 0 {
+		throughputRatio = float64(obs.window.execs) / float64(obs.bestExecs)
+	}
+	return features{
+		1,
+		clampFloat(float64(obs.now.Sub(obs.leaseStarted))/float64(max(time.Second, obs.leaseLimit)), 0, 3),
+		clampFloat(float64(obs.now.Sub(obs.vmStarted))/float64(max(time.Second, obs.leaseLimit)), 0, 6),
+		clampFloat(float64(obs.now.Sub(obs.lastProgress))/float64(max(time.Second, obs.leaseLimit)), 0, 6),
+		math.Log1p(float64(obs.window.execs)) / 20,
+		clampFloat(throughputRatio, 0, 2),
+		math.Log1p(float64(obs.window.newSignal)) / 5,
+		math.Log1p(float64(obs.window.stableSignal)) / 5,
+		math.Log1p(float64(obs.window.newInputs)) / 3,
+		math.Log1p(healthRate) / 3,
+		clampFloat(float64(obs.softResets)/8, 0, 2),
+		boolFloat(obs.peerLastProgress.After(obs.lastProgress)),
+		math.Log1p(stateNoveltyRate(obs.window)) / 5,
+		math.Tanh(obs.fingerprint.depth() / 8),
+		math.Tanh(obs.stateValue / 20),
+		clampFloat(float64(obs.stateAge)/float64(max(time.Second, controllerStateAgeScale(obs))), 0, 6),
+	}
+}
+
+// controllerStateAgeScale returns the lease-relative scale used to normalize state age.
+func controllerStateAgeScale(obs restartObservation) time.Duration {
+	if obs.leaseLimit > 0 {
+		return obs.leaseLimit
+	}
+	return time.Hour
+}
+
+// boolFloat converts a boolean feature to zero or one.
+func boolFloat(value bool) float64 {
+	if value {
+		return 1
+	}
+	return 0
+}
+
+// clampFloat bounds a floating-point value to the inclusive interval.
+func clampFloat(value, low, high float64) float64 {
+	return min(high, max(low, value))
+}
+
+// prepareActionLocked reserves a disruptive action and fills its snapshot
+// selection or promotion metadata. The caller must hold c.mu.
+func (c *Controller) prepareActionLocked(vm int, dec *RestartDecision) {
+	state := c.states[vm]
+	if !c.reserveActionLocked(state, dec) {
+		return
+	}
+	switch dec.Action {
+	case RestartSoft:
+		rnd := c.randomFloat(vm)
+		snapshot := state.bank.selectRandom(nil, rnd)
+		dec.SnapshotName = snapshot.name
+	case RestartCheckpoint:
+		state.bank.nextID++
+		dec.SnapshotName = fmt.Sprintf("state-%d-%d", vm, state.bank.nextID)
+		dec.DeleteSnapshot = state.bank.evictionCandidate(c.policy.snapshotBankSize)
+	}
+}
+
+// reserveActionLocked accepts an existing reservation, reserves concurrency
+// capacity for a disruptive action, or changes it to continue when the action
+// limit is reached. The caller must hold c.mu.
+func (c *Controller) reserveActionLocked(state *VMState, dec *RestartDecision) bool {
+	if dec.Action == RestartContinue || state.actionInFlight {
+		return true
+	}
+	if c.policy.maxConcurrentActions > 0 &&
+		c.inFlight >= c.policy.maxConcurrentActions {
+		dec.Action = RestartContinue
+		dec.Reason = RestartReasonActionLimit
+		if c.statActionDeferred != nil {
+			c.statActionDeferred.Add(1)
+		}
+		return false
+	}
+	state.actionInFlight = true
+	c.inFlight++
+	return true
+}
+
+// startLearningSampleLocked starts outcome attribution for a decision and marks
+// whether it may train the online learner. The caller must hold c.mu.
+func (c *Controller) startLearningSampleLocked(state *VMState, dec RestartDecision, feats features,
+	baseline feedbackSnapshot, now time.Time) {
+	state.pending = &learningSample{
+		action:   dec.Action,
+		features: feats,
+		baseline: baseline,
+		started:  now,
+		snapshot: dec.SnapshotName,
+		learn: c.policy.decisionMode == "bandit" &&
+			(dec.Reason == RestartReasonOnlinePolicy ||
+				dec.Reason == RestartReasonStatePromotion),
+		attempted: dec.Action == RestartContinue,
+	}
+}
+
+// finishLearningSampleLocked computes an attempted action's reward, updates the
+// learner and snapshot quality, and clears the sample. The caller must hold c.mu.
+func (c *Controller) finishLearningSampleLocked(state *VMState, current feedbackSnapshot, now time.Time) {
+	if state.pending == nil {
+		return
+	}
+	sample := state.pending
+	if !sample.attempted {
+		// A selected action can be superseded by a safety boundary before the
+		// manager attempts it. Such a censored action has no observable reward.
+		state.pending = nil
+		return
+	}
+	delta := current.delta(sample.baseline)
+	reward := Reward(delta, now.Sub(sample.started), sample.cost, sample.failed)
+	if c.policy.decisionMode == "bandit" && sample.learn {
+		c.learner.update(sample.action, sample.features, reward)
+		if c.statModelUpdate != nil {
+			c.statModelUpdate.Add(1)
+		}
+	}
+	if sample.snapshot != "" &&
+		(sample.action == RestartSoft || sample.action == RestartCheckpoint) {
+		if snapshot := state.bank.find(sample.snapshot); snapshot != nil {
+			snapshot.observe(reward)
+			if sample.action == RestartSoft && snapshot.promotionLearn &&
+				c.policy.decisionMode == "bandit" && c.learner != nil {
+				// Checkpoint utility is delayed until a retained state is reused.
+				// Feed that realized benefit back to the creation context instead
+				// of training checkpoint only on its immediate save cost.
+				c.learner.update(RestartCheckpoint, snapshot.promotionFeatures, reward)
+				if c.statModelUpdate != nil {
+					c.statModelUpdate.Add(1)
+				}
+				if c.statCheckpointCredit != nil {
+					c.statCheckpointCredit.Add(1)
+				}
+			}
+		}
+	}
+	if c.statReward != nil && sample.learn {
+		c.statReward.Add(int(reward * 100))
+	}
+	state.pending = nil
+}
+
+// evaluateAdaptiveRestart returns the threshold heuristic's action for an observation.
+func evaluateAdaptiveRestart(obs restartObservation, policy RestartPolicy) RestartDecision {
+	dec := decisionFromObservation(obs)
+	switch {
+	case dec.VMAge >= policy.hardMax:
+		dec.Action, dec.Reason = RestartHard, RestartReasonVMLifetime
+	case obs.softResets >= policy.maxSoftResets:
+		dec.Action, dec.Reason = RestartHard, RestartReasonTooManyRestores
+	case dec.LeaseAge < policy.minLease:
+	case unhealthyWindow(obs.window, policy.unhealthy):
+		dec.Action, dec.Reason = RestartSoft, RestartReasonUnhealthy
+	case obs.lowThroughputWindows >= 3:
+		dec.Action, dec.Reason = RestartSoft, RestartReasonThroughput
+	case dec.LeaseAge >= obs.leaseLimit:
+		dec.Action, dec.Reason = RestartSoft, RestartReasonLeaseLimit
+	case dec.StagnantFor < policy.stall:
+	default:
+		stallPeriods := float64(dec.StagnantFor) / float64(policy.stall)
+		probability := min(0.75, stallPeriods*0.10)
+		if obs.peerLastProgress.After(obs.lastProgress) {
+			probability = min(0.90, probability+0.25)
+		}
+		if stallPeriods >= 3 || obs.random < probability {
+			dec.Action, dec.Reason = RestartSoft, RestartReasonStalled
+		}
+	}
+	return dec
+}
+
+// RecordDecision increments action and reason statistics for an issued decision.
+func (c *Controller) RecordDecision(dec RestartDecision) {
+	switch dec.Action {
+	case RestartCheckpoint:
+		c.statCheckpoint.Add(1)
+	case RestartSoft:
+		c.statSoftReset.Add(1)
+		if dec.SnapshotName != "" && dec.SnapshotName != CleanSnapshotName {
+			c.statIntermediateRestore.Add(1)
+		}
+	case RestartHard:
+		c.statHardReset.Add(1)
+	}
+	switch dec.Reason {
+	case RestartReasonStalled:
+		c.statStalled.Add(1)
+	case RestartReasonThroughput:
+		c.statThroughput.Add(1)
+	case RestartReasonUnhealthy:
+		c.statUnhealthy.Add(1)
+	case RestartReasonLeaseLimit:
+		c.statLeaseLimit.Add(1)
+	case RestartReasonVMLifetime:
+		c.statVMLifetime.Add(1)
+	case RestartReasonTooManyRestores:
+		c.statRestoreLimit.Add(1)
+	case RestartReasonCrashRecovery:
+		c.statCrashRecovery.Add(1)
+		if dec.SnapshotName != "" && dec.SnapshotName != CleanSnapshotName {
+			c.statCrashIntermediate.Add(1)
+		}
+	case RestartReasonRunEnded:
+		c.statRunEnded.Add(1)
+	}
+}
