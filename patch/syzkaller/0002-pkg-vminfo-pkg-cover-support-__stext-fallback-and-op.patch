diff --git a/pkg/vminfo/linux_test.go b/pkg/vminfo/linux_test.go
index a047a1f23..5d33fd520 100644
--- a/pkg/vminfo/linux_test.go
+++ b/pkg/vminfo/linux_test.go
@@ -89,6 +89,25 @@ func TestLinuxSyscalls(t *testing.T) {
