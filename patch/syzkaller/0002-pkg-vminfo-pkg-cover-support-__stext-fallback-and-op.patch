From c450e24e9da184d534a3e02f0afb6ab5eb460fd1 Mon Sep 17 00:00:00 2001
From: SyzAster Authors <syzaster@asterinas.org>
Date: Sat, 31 Oct 2026 10:54:17 +0800
Subject: [PATCH 2/4] pkg/vminfo, pkg/cover: support __stext fallback and
 optional kallsyms

Allow ELF coverage symbol resolution to fall back to __stext when _stext
is absent, and skip module address parsing from /proc/kallsyms when
coverage is disabled on Linux-compatible kernels.
---
 pkg/cover/backend/elf.go      | 11 +++++++++++
 pkg/cover/backend/elf_test.go | 23 +++++++++++++++++++++++
 pkg/vminfo/linux.go           |  9 +++++++++
 pkg/vminfo/linux_test.go      | 19 +++++++++++++++++++
 pkg/vminfo/vminfo.go          |  2 +-
 5 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/pkg/cover/backend/elf.go b/pkg/cover/backend/elf.go
index b8c771ef9..4748d46fb 100644
--- a/pkg/cover/backend/elf.go
+++ b/pkg/cover/backend/elf.go
@@ -257,10 +257,21 @@ func getLinuxPCBase(cfg *mgrconfig.Config) (uint64, error) {
 	if err != nil {
 		return 0, err
 	}
+	return findLinuxPCBase(allSymbols)
+}
+
+func findLinuxPCBase(allSymbols []elf.Symbol) (uint64, error) {
+	var fallback uint64
 	for _, sym := range allSymbols {
 		if sym.Name == "_stext" {
 			return sym.Value, nil
 		}
+		if sym.Name == "__stext" && fallback == 0 {
+			fallback = sym.Value
+		}
+	}
+	if fallback != 0 {
+		return fallback, nil
 	}
 	return 0, fmt.Errorf("no _stext symbol")
 }
diff --git a/pkg/cover/backend/elf_test.go b/pkg/cover/backend/elf_test.go
index 56272ac66..3c6cbb27c 100644
--- a/pkg/cover/backend/elf_test.go
+++ b/pkg/cover/backend/elf_test.go
@@ -4,9 +4,32 @@
 package backend
 
 import (
+	"debug/elf"
 	"testing"
 )
 
+func TestFindLinuxPCBase(t *testing.T) {
+	base, err := findLinuxPCBase([]elf.Symbol{
+		{Name: "__stext", Value: 0xffffffff8804b000},
+		{Name: "_stext", Value: 0xffffffff81000000},
+	})
+	if err != nil || base != 0xffffffff81000000 {
+		t.Fatalf("expected _stext preference, got %#x (%v)", base, err)
+	}
+
+	base, err = findLinuxPCBase([]elf.Symbol{
+		{Name: "other", Value: 0x1000},
+		{Name: "__stext", Value: 0xffffffff8804b000},
+	})
+	if err != nil || base != 0xffffffff8804b000 {
+		t.Fatalf("expected __stext fallback, got %#x (%v)", base, err)
+	}
+
+	if _, err := findLinuxPCBase([]elf.Symbol{{Name: "other", Value: 0x1000}}); err == nil {
+		t.Fatalf("expected error when neither _stext nor __stext is present")
+	}
+}
+
