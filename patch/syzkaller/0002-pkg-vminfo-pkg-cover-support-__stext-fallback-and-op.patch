+func TestLinuxModulesWithoutKallsyms(t *testing.T) {
+	files := filesystem{}
+	modules, err := (linux{cover: false}).parseModules(files)
+	require.NoError(t, err)
+	require.Empty(t, modules)
+
+	_, err = (linux{cover: true}).parseModules(files)
+	require.ErrorContains(t, err, "failed to get _stext symbol")
+
+	files["/proc/kallsyms"] = &flatrpc.FileInfo{
+		Name: "/proc/kallsyms", Exists: true,
+		Data: []byte("ffffffff81000000 T _stext\nffffffff82000000 R _etext\n"),
+	}
+	modules, err = (linux{cover: false}).parseModules(files)
+	require.NoError(t, err)
+	require.Len(t, modules, 1)
+	require.Equal(t, uint64(0xffffffff81000000), modules[0].Addr)
+}
