+func TestAsterinasPanicsHaveDistinctTitles(t *testing.T) {
+	reporter, _ := prepareLinuxReporter(t, targets.AMD64)
+	logs := []string{
+		"\x1b[32m[    82.115]\x1b[0m ERROR: Uncaught panic:\n" +
+			"\tassertion failed: addr.is_unicast()\n" +
+			"\tat /root/.cargo/git/checkouts/smoltcp/revision/src/iface/route.rs:150\n" +
+			"Printing stack trace:\n  1: fn 0xffffffff88000000\n",
+		"[    91.693] ERROR: Uncaught panic:\n" +
+			"\tnot implemented\n" +
+			"\tat /src/asterinas/kernel/core/src/syscall/timer_create.rs:74\n" +
+			"Printing stack trace:\n  1: fn 0xffffffff88000000\n",
+	}
+	want := []string{
+		"asterinas panic: assertion failed: addr.is_unicast() at src/iface/route.rs:LINE",
+		"asterinas panic: not implemented at src/syscall/timer_create.rs:LINE",
+	}
+	for i, log := range logs {
+		if !reporter.ContainsCrash([]byte(log)) {
+			t.Fatalf("log %d was not recognized as a crash", i)
+		}
+		rep := reporter.Parse([]byte(log))
+		if rep == nil {
+			t.Fatalf("log %d was not parsed", i)
+		}
+		assert.Equal(t, want[i], rep.Title)
+		assert.True(t, rep.Panicked)
+		assert.Contains(t, string(rep.Report), "Printing stack trace:")
+	}
+}
