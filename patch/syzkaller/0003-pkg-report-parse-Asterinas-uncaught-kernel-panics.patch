From: SyzAster Authors <syzaster@asterinas.org>
Date: Sat, 31 Oct 2026 10:54:17 +0800
Subject: [PATCH 3/4] pkg/report: parse Asterinas uncaught kernel panics

Recognize Asterinas 'Uncaught panic:' reports and extract the panic
reason and source file location into distinct crash titles.
---
 pkg/report/linux.go      | 30 ++++++++++++++++++++++++++++++
 pkg/report/linux_test.go | 30 ++++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+)

diff --git a/pkg/report/linux.go b/pkg/report/linux.go
index c0151799c..ea73f204d 100644
--- a/pkg/report/linux.go
+++ b/pkg/report/linux.go
@@ -314,6 +314,9 @@ func (ctx *linux) Parse(output []byte) *Report {
 	if oops == nil {
 		return nil
 	}
+	if rep := parseAsterinasPanic(output); rep != nil && rep.StartPos == startPos {
+		return rep
+	}
 	for questionable := false; ; questionable = true {
 		rep := &Report{
 			Output:   output,
@@ -370,6 +373,33 @@ func (ctx *linux) Parse(output []byte) *Report {
 	}
 }
 
+var asterinasPanicRe = regexp.MustCompile(`Uncaught panic:\r?\n[ \t]*([^\r\n]+)\r?\n[ \t]*at ([^\r\n]+)`)
+
+func parseAsterinasPanic(output []byte) *Report {
+	match := asterinasPanicRe.FindSubmatchIndex(output)
+	if match == nil || !bytes.Contains(output[match[1]:], []byte("Printing stack trace:")) {
+		return nil
+	}
+	startPos := bytes.LastIndexByte(output[:match[0]], '\n') + 1
+	reason := strings.TrimSpace(string(output[match[2]:match[3]]))
+	location := strings.Split(strings.TrimSpace(string(output[match[4]:match[5]])), "/")
+	if len(location) > 3 {
+		location = location[len(location)-3:]
+	}
+	title := fmt.Sprintf("asterinas panic: %s at %s", reason, strings.Join(location, "/"))
+	rep := &Report{
+		Title:    title,
+		Type:     crash.TitleToType(title),
+		Output:   output,
+		Report:   output[startPos:],
+		StartPos: startPos,
+		EndPos:   len(output),
+		Panicked: true,
+	}
+	setExecutorInfo(rep)
+	return rep
+}
+
