From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SyzAster Authors <syzaster@asterinas.org>
Date: Sat, 31 Oct 2026 10:54:17 +0800
Subject: [PATCH 1/4] executor: support Asterinas /dev/kcov fallback and
 optional netns

Asterinas exposes KCOV as /dev/kcov without debugfs and does not yet
implement /proc/self/ns/net or netfilter socket options. Add open_kcov()
helper falling back to /dev/kcov on ENOENT, tolerate EOPNOTSUPP in
netfilter table checkpoints, and allow missing /proc/self/ns/net when
devlink_pci is not enabled.
---
 executor/common_linux.h   | 20 +++++++++++++++-----
 executor/executor_linux.h | 22 ++++++++++++++++------
 2 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/executor/common_linux.h b/executor/common_linux.h
index f9eeb3c29..c8e66440e 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -3789,6 +3789,7 @@ static void checkpoint_iptables(struct ipt_table_desc* tables, int num_tables, i
 			case EPERM:
 			case ENOENT:
 			case ENOPROTOOPT:
+			case EOPNOTSUPP:
 				continue;
 			}
 			failmsg("iptable checkpoint: getsockopt(IPT_SO_GET_INFO) failed",
@@ -3890,6 +3891,7 @@ static void checkpoint_arptables(void)
 			case EPERM:
 			case ENOENT:
 			case ENOPROTOOPT:
+			case EOPNOTSUPP:
 				continue;
 			}
 			failmsg("arptable checkpoint: getsockopt(ARPT_SO_GET_INFO) failed", "table=%s", table->name);
@@ -4034,6 +4036,7 @@ static void checkpoint_ebtables(void)
 			case EPERM:
 			case ENOENT:
 			case ENOPROTOOPT:
+			case EOPNOTSUPP:
 				continue;
 			}
 			failmsg("ebtable checkpoint: getsockopt(EBT_SO_GET_INIT_INFO) failed",
@@ -4489,11 +4492,18 @@ static void sandbox_common()
 
 #if SYZ_EXECUTOR || __NR_syz_init_net_socket || SYZ_DEVLINK_PCI || __NR_syz_socket_connect_nvme_tcp
 	int netns = open("/proc/self/ns/net", O_RDONLY);
-	if (netns == -1)
-		fail("open(/proc/self/ns/net) failed");
-	if (dup2(netns, kInitNetNsFd) < 0)
-		fail("dup2(netns, kInitNetNsFd) failed");
-	close(netns);
+	if (netns == -1) {
+#if SYZ_EXECUTOR
+		// Some Linux-compatible kernels have no network namespaces. They can still
+		// run programs when no enabled setup needs the initial namespace fd.
+		if (errno != ENOENT || flag_devlink_pci)
+#endif
+			fail("open(/proc/self/ns/net) failed");
+	} else {
+		if (dup2(netns, kInitNetNsFd) < 0)
+			fail("dup2(netns, kInitNetNsFd) failed");
+		close(netns);
+	}
 #endif
 
 	struct rlimit rlim;
diff --git a/executor/executor_linux.h b/executor/executor_linux.h
index cb23350d5..fa836c033 100644
--- a/executor/executor_linux.h
+++ b/executor/executor_linux.h
@@ -151,11 +151,21 @@ static intptr_t execute_syscall(const call_t* c, intptr_t a[kMaxArgs])
 	return syscall(c->sys_nr, a[0], a[1], a[2], a[3], a[4], a[5]);
 }
 
-static void cover_open(cover_t* cov, bool extra)
+static int open_kcov()
 {
 	int fd = open("/sys/kernel/debug/kcov", O_RDWR);
+	// Asterinas exposes KCOV as a character device without requiring debugfs.
+	// Keep the Linux path preferred, and do not mask errors such as EACCES.
+	if (fd == -1 && errno == ENOENT)
+		fd = open("/dev/kcov", O_RDWR);
+	return fd;
+}
+
+static void cover_open(cover_t* cov, bool extra)
+{
+	int fd = open_kcov();
 	if (fd == -1)
-		fail("open of /sys/kernel/debug/kcov failed");
+		fail("open of kcov failed");
 	if (dup2(fd, cov->fd) < 0)
 		failmsg("filed to dup cover fd", "from=%d, to=%d", fd, cov->fd);
 	close(fd);
@@ -362,9 +372,9 @@ static const char* setup_devlink_pci()
 
 static const char* setup_delay_kcov()
 {
-	int fd = open("/sys/kernel/debug/kcov", O_RDWR);
+	int fd = open_kcov();
 	if (fd == -1)
-		return "open of /sys/kernel/debug/kcov failed";
+		return "open of kcov failed";
 	close(fd);
 	cover_t cov = {};
 	cov.fd = kCoverFd;
@@ -392,9 +402,9 @@ static const char* setup_delay_kcov()
 
 static const char* setup_kcov_reset_ioctl()
 {
-	int fd = open("/sys/kernel/debug/kcov", O_RDWR);
+	int fd = open_kcov();
 	if (fd == -1)
-		return "open of /sys/kernel/debug/kcov failed";
+		return "open of kcov failed";
 	close(fd);
 
 	cover_t cov = {};
-- 
